{
  "name": "chunkpilot-curseforge-service",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": {
    "DAILY_UPSTREAM_REQUESTS": "20000",
    "DAILY_UPSTREAM_BYTES": "53687091200",
    "MAX_CONCURRENT_OPERATIONS": "24"
  },
  "ratelimits": [
    { "name": "CURSEFORGE_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [{ "name": "CURSEFORGE_BUDGET", "class_name": "CurseForgeBudget" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CurseForgeBudget"] }]
}
