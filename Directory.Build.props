<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Keep the Windows upgrade identity above the previously shipped 1.3.0 alpha installers. -->
    <ApplicationVersion>1.3.1</ApplicationVersion>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.3.1.0</AssemblyVersion>
    <FileVersion>1.3.1.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Company>ChunkPilot</Company>
    <Product>ChunkPilot</Product>
    <Copyright>Copyright © 2026 ChunkPilot</Copyright>
  </PropertyGroup>
</Project>
