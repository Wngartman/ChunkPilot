<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationVersion>1.3.0</ApplicationVersion>
    <Version>1.3.0-alpha.5</Version>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>
    <InformationalVersion>1.3.0-alpha.5</InformationalVersion>
    <Company>ChunkPilot</Company>
    <Product>ChunkPilot</Product>
    <Copyright>Copyright © 2026 ChunkPilot</Copyright>
  </PropertyGroup>
</Project>
