<Project>
  <PropertyGroup>
    <ChunkPilotReleaseTag Condition="'$(ChunkPilotReleaseTag)' == ''">v$(Version)</ChunkPilotReleaseTag>
    <ChunkPilotGitSha Condition="'$(ChunkPilotGitSha)' == ''">unknown</ChunkPilotGitSha>
    <ChunkPilotBuildTimestampUtc Condition="'$(ChunkPilotBuildTimestampUtc)' == ''">unknown</ChunkPilotBuildTimestampUtc>
    <InformationalVersion>$(Version)+$(ChunkPilotGitSha)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="ChunkPilotReleaseTag" Value="$(ChunkPilotReleaseTag)" />
    <AssemblyMetadata Include="ChunkPilotGitSha" Value="$(ChunkPilotGitSha)" />
    <AssemblyMetadata Include="ChunkPilotBuildTimestampUtc" Value="$(ChunkPilotBuildTimestampUtc)" />
    <AssemblyMetadata Include="ChunkPilotDefaultUi" Value="WebUI" />
    <AssemblyMetadata Include="ChunkPilotSchemaVersion" Value="6" />
  </ItemGroup>
</Project>
