<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>ChunkPilot</AssemblyName>
    <ApplicationIcon>..\..\assets\ChunkPilot.ico</ApplicationIcon>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ChunkPilot.Core\ChunkPilot.Core.csproj" />
    <ProjectReference Include="..\ChunkPilot.Infrastructure\ChunkPilot.Infrastructure.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="FluentIcons.Wpf" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\..\assets\ChunkPilot.ico" Link="Assets\ChunkPilot.ico" />
    <None Include="..\..\assets\ChunkPilot.ico" Link="Assets\ChunkPilot.ico"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Two frames, not one. The splash draws the mark large and uses the 256; the navigation
         rail draws it at 32 DIP and uses the 64, which still has headroom at 150% scaling.
         Scaling the 256 down to 32 at runtime is the defect the brand rework exists to remove. -->
    <Resource Include="..\..\assets\ChunkPilot-256.png" Link="Assets\ChunkPilot-256.png" />
    <Resource Include="..\..\assets\brand\ChunkPilot-64.png" Link="Assets\ChunkPilot-64.png" />
  </ItemGroup>
  <ItemGroup Condition="Exists('..\ChunkPilot.WebUi\dist\index.html')">
    <Content Include="..\ChunkPilot.WebUi\dist\**\*"
             Link="WebUi\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="EnsureWebUiAssets"
          BeforeTargets="PrepareForBuild"
          Condition="'$(Configuration)' == 'Release' and !Exists('..\ChunkPilot.WebUi\dist\index.html')">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\build-webui.ps1&quot; -SkipTests" />
  </Target>
</Project>
