<Window x:Class="ChunkPilot.App.ServerIconLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ds="clr-namespace:ChunkPilot.App.DesignSystem"
        Title="Saved server icons" Style="{StaticResource AppDialogWindow}"
        Width="{StaticResource AppServerIconLibraryDialogWidth}"
        Height="{StaticResource AppServerIconLibraryDialogHeight}"
        MinWidth="{StaticResource AppDialogWidth}" MinHeight="{StaticResource AppDialogWidth}"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource AppDialogHeader}">
            <StackPanel>
                <TextBlock Text="Saved server icons" Style="{StaticResource AppTitleLargeText}"/>
                <TextBlock Text="Previously cropped icons are stored in ChunkPilot and can be reused on any server."
                           Style="{StaticResource AppSecondaryText}" TextWrapping="Wrap"
                           Margin="{StaticResource AppStackGap}"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource AppDialogBody}">
            <ListBox x:Name="IconList" ItemsSource="{Binding}" MouseDoubleClick="Use_Click"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Saved server icons">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="{StaticResource AppInset8}" MinHeight="{StaticResource AppServerIconPreviewSize}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="{StaticResource AppServerIconPreviewSize}"
                                    Height="{StaticResource AppServerIconPreviewSize}"
                                    Background="{DynamicResource AppSurfaceSunken}"
                                    BorderBrush="{DynamicResource AppStrokeSubtle}"
                                    BorderThickness="{StaticResource AppStrokeThickness}"
                                    CornerRadius="{StaticResource AppCornerControl}">
                                <Image Source="{Binding Preview}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="{StaticResource AppInlineGapLeadingLarge}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Entry.Name}" Style="{StaticResource AppBodyStrongText}"/>
                                <TextBlock Text="{Binding Entry.CreatedAt, StringFormat=Saved {0:g}}" Style="{StaticResource AppMutedText}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource AppDialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Margin="{StaticResource AppInlineGap}"/>
                <Button Content="Use selected" Style="{StaticResource AppPrimaryButton}"
                        ds:AppButton.Icon="Checkmark" IsDefault="True" Click="Use_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
