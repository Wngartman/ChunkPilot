<Window x:Class="ChunkPilot.App.CurseForgeCredentialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:ChunkPilot.App.DesignSystem.Components"
        Title="Set up CurseForge" Style="{StaticResource AppDialogWindow}"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="{StaticResource AppInset24}" Width="{StaticResource AppMeasureForm}">
        <TextBlock Text="Connect your CurseForge access" Style="{StaticResource AppTitleLargeText}" TextWrapping="Wrap"/>
        <TextBlock Text="Enter your own approved CurseForge API key. ChunkPilot checks it with CurseForge over HTTPS, then encrypts it for this Windows user. Your worlds and server files are not sent."
                   Style="{StaticResource AppSecondaryText}" TextWrapping="Wrap" Margin="{StaticResource AppStackGap}"/>
        <Button x:Name="AccessGuideButton" Content="How to get CurseForge API access" Style="{StaticResource AppLinkButton}"
                HorizontalAlignment="Left" Click="AccessGuide_Click"/>
        <TextBlock x:Name="CurrentStatus" Style="{StaticResource AppSecondaryText}" TextWrapping="Wrap" Margin="{StaticResource AppStackGap}"/>
        <Label Content="CurseForge API key" Target="{Binding ElementName=KeyBox}"/>
        <PasswordBox x:Name="KeyBox" MaxLength="4096" PasswordChanged="KeyBox_PasswordChanged"
                     AutomationProperties.Name="CurseForge API key"/>
        <components:AppAlert x:Name="ValidationAlert" Tone="Danger" Title="Could not update CurseForge access"
                             Margin="{StaticResource AppStackGapTop}" Visibility="Collapsed"/>
        <TextBlock x:Name="ProgressText" Text="Checking with CurseForge…" Style="{StaticResource AppSecondaryText}"
                   Margin="{StaticResource AppStackGapTop}" Visibility="Collapsed"/>
        <WrapPanel HorizontalAlignment="Right" Margin="{StaticResource AppStackGapTop}">
            <Button x:Name="RemoveButton" Content="Remove saved key" Click="Remove_Click" Margin="{StaticResource AppInlineGap}"/>
            <Button Content="Cancel" IsCancel="True" Margin="{StaticResource AppInlineGap}"/>
            <Button x:Name="SaveButton" Content="Validate and save" Style="{StaticResource AppPrimaryButton}"
                    IsDefault="True" IsEnabled="False" Click="Save_Click"/>
        </WrapPanel>
    </StackPanel>
</Window>
