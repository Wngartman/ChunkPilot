<!--
    Create Server v2 — live Vanilla wizard.

    The authoritative normal Vanilla creation workflow. The retained live command-line switch opens
    this same product composition for development review.

    Unlike the synthetic preview, everything shown here is real: the versions come from Mojang through
    the Agent, and the Create action starts one genuine creation operation. The composition, tokens
    and components are the same accepted Visual System v2 the preview established; nothing here
    invents a visual value.
-->
<Window x:Class="ChunkPilot.App.CreateServerLive.CreateServerLiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ds="clr-namespace:ChunkPilot.App.DesignSystem"
        xmlns:components="clr-namespace:ChunkPilot.App.DesignSystem.Components"
        xmlns:live="clr-namespace:ChunkPilot.App.CreateServerLive"
        Title="Create a server - ChunkPilot"
        Width="1120" Height="780" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ds:AppLayout.IsResponsive="True">

    <Window.Resources>
        <live:LiveBooleanVisibilityConverter x:Key="LiveBoolVisibility" />
        <live:LiveStepVisibilityConverter x:Key="LiveStepVisibility" />
        <live:LiveAnyItemsVisibilityConverter x:Key="LiveAnyItems" />
        <live:LiveNonEmptyVisibilityConverter x:Key="LiveNonEmpty" />
        <live:VanillaSupportToneConverter x:Key="SupportTone" />
        <live:VanillaSupportIconConverter x:Key="SupportIcon" />
        <live:VanillaSupportBadgeConverter x:Key="SupportBadge" />
        <live:VanillaVersionSubtitleConverter x:Key="VersionSubtitle" />
        <live:CreationStageToneConverter x:Key="StageTone" />

        <DataTemplate x:Key="LiveReviewRowTemplate">
            <components:AppInfoRow Label="{Binding Label}" Value="{Binding Value}"
                                   IsUnknown="{Binding IsUnknown}" UnknownText="{Binding UnknownText}">
                <components:AppInfoRow.ActionContent>
                    <Button Content="Copy" ds:AppButton.Icon="Copy" Style="{StaticResource AppLinkButton}"
                            Command="{Binding DataContext.CopyValueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding Value}"
                            Visibility="{Binding IsCopyable, Converter={StaticResource BoolVisibility}}"
                            AutomationProperties.Name="Copy this full value" />
                </components:AppInfoRow.ActionContent>
            </components:AppInfoRow>
        </DataTemplate>

        <DataTemplate x:Key="LiveReviewNoteTemplate">
            <StackPanel Margin="{StaticResource AppStackGap}">
                <TextBlock Style="{StaticResource AppLabelText}" Text="{Binding Label}" />
                <TextBlock Style="{StaticResource AppBodyText}" TextWrapping="Wrap" Text="{Binding Text}" />
            </StackPanel>
        </DataTemplate>

        <!-- Plain wrapped sentence, used everywhere a list of findings is rendered. -->
        <DataTemplate x:Key="LiveMessageTemplate">
            <TextBlock Style="{StaticResource AppSecondaryText}" TextWrapping="Wrap"
                       MaxWidth="{StaticResource AppMeasureForm}" HorizontalAlignment="Left"
                       Margin="{StaticResource AppStackGapSmall}" Text="{Binding}" />
        </DataTemplate>

        <!-- Display components are not tab stops. WPF makes every Control focusable, which would
             otherwise collect a dead stop for each header, badge, alert and row. -->
        <Style TargetType="{x:Type components:AppPageHeader}" BasedOn="{StaticResource AppPageHeader}">
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style TargetType="{x:Type components:AppStatusBadge}" BasedOn="{StaticResource AppStatusBadge}">
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style TargetType="{x:Type components:AppAlert}" BasedOn="{StaticResource AppAlert}">
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style TargetType="{x:Type components:AppSectionCard}" BasedOn="{StaticResource AppSectionCard}">
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style TargetType="{x:Type components:AppEmptyState}" BasedOn="{StaticResource AppEmptyState}">
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style TargetType="{x:Type components:AppInfoRow}" BasedOn="{StaticResource AppInfoRow}">
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style TargetType="{x:Type components:AppServerRow}" BasedOn="{StaticResource AppServerRow}">
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style TargetType="{x:Type components:AppLoadingState}" BasedOn="{StaticResource AppLoadingState}">
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style TargetType="{x:Type components:AppProgressPanel}" BasedOn="{StaticResource AppProgressPanel}">
            <Setter Property="Focusable" Value="False" />
        </Style>

        <Style x:Key="LiveVersionContainer" TargetType="ListBoxItem" BasedOn="{StaticResource AppListRow}">
            <Setter Property="Padding" Value="{StaticResource AppInsetNone}" />
            <Setter Property="Margin" Value="{StaticResource AppStackGapSmall}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Style.Triggers>
                <!-- A version ChunkPilot cannot create is shown with its reason and cannot be picked. -->
                <DataTrigger Binding="{Binding IsSelectable}" Value="False">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource AppPageSurface}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══ Identity ═══ -->
            <components:AppPageHeader Grid.Row="0" Icon="Add"
                                      Title="Create a server"
                                      Description="Pick what you want to play. ChunkPilot handles the rest.">
                <components:AppPageHeader.StatusContent>
                    <!-- Icon and text, not a capsule. The state is worth stating and worth its
                         warning colour; the oval around it was decoration, and the colour is not
                         carrying the meaning on its own. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ds:AppIcon Kind="Lab" Scale="Small"
                                    Margin="{StaticResource AppInlineGap}"
                                    Foreground="{DynamicResource AppWarningText}" />
                        <TextBlock Text="Development build · Vanilla only"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource AppSecondaryText}"
                                   Foreground="{DynamicResource AppWarningText}"
                                   AutomationProperties.Name="Development build. Only Vanilla can be created." />
                    </StackPanel>
                </components:AppPageHeader.StatusContent>
            </components:AppPageHeader>

            <!-- ═══ Compact step strip ═══ -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Steps}" Focusable="False"
                          Margin="{StaticResource AppStackGap}"
                          AutomationProperties.Name="Wizard steps">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=(ds:AppLayout.Mode), RelativeSource={RelativeSource Self}}" Value="Compact">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="{StaticResource AppInlineGapLarge}"
                                AutomationProperties.Name="{Binding AutomationName}">
                            <StackPanel Orientation="Horizontal">
                                <ds:AppIcon x:Name="StripMark" Kind="ChevronRight" Scale="Small"
                                            VerticalAlignment="Center"
                                            Margin="{StaticResource AppInlineGap}"
                                            Foreground="{DynamicResource AppTextMuted}" />
                                <TextBlock x:Name="StripLabel" Style="{StaticResource AppMutedText}"
                                           VerticalAlignment="Center" Text="{Binding Title}" />
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                <Setter TargetName="StripMark" Property="Kind" Value="Checkmark" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="StripMark" Property="Kind" Value="ChevronRight" />
                                <Setter TargetName="StripMark" Property="Foreground" Value="{DynamicResource AppTextAccent}" />
                                <Setter TargetName="StripLabel" Property="Style" Value="{StaticResource AppBodyStrongText}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ═══ Body ═══ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ItemsControl Grid.Column="0" ItemsSource="{Binding Steps}" Focusable="False"
                              Width="{StaticResource AppNavRailWidth}"
                              Margin="{StaticResource AppInlineGapLarge}"
                              AutomationProperties.Name="Wizard steps">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=(ds:AppLayout.Mode), RelativeSource={RelativeSource Self}}" Value="Compact">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="RailRow" Padding="{StaticResource AppRowPadding}"
                                    MinHeight="{StaticResource AppNavRowHeight}"
                                    CornerRadius="{StaticResource AppCornerControl}"
                                    BorderThickness="{StaticResource AppSelectionIndicatorThickness}"
                                    BorderBrush="{DynamicResource AppSurfaceTransparent}"
                                    Background="{DynamicResource AppSurfaceTransparent}"
                                    AutomationProperties.Name="{Binding AutomationName}">
                                <StackPanel Orientation="Horizontal">
                                    <ds:AppIcon x:Name="RailMark" Kind="ChevronRight" Scale="Small"
                                                VerticalAlignment="Center"
                                                Margin="{StaticResource AppInlineGapLarge}"
                                                Foreground="{DynamicResource AppTextMuted}" />
                                    <TextBlock x:Name="RailLabel" Style="{StaticResource AppSecondaryText}"
                                               VerticalAlignment="Center" TextWrapping="Wrap"
                                               Text="{Binding Title}" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                    <Setter TargetName="RailMark" Property="Kind" Value="Checkmark" />
                                    <Setter TargetName="RailMark" Property="Foreground" Value="{DynamicResource AppSuccessText}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="RailRow" Property="Background" Value="{DynamicResource AppAccentSubtle}" />
                                    <Setter TargetName="RailRow" Property="BorderBrush" Value="{DynamicResource AppAccentIndicator}" />
                                    <Setter TargetName="RailMark" Property="Foreground" Value="{DynamicResource AppTextAccent}" />
                                    <Setter TargetName="RailLabel" Property="Style" Value="{StaticResource AppBodyStrongText}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- The single page scroller. Nothing inside may add another scroll region. -->
                <ScrollViewer x:Name="WizardScroller" Grid.Column="1" Style="{StaticResource AppPageScrollViewer}">
                    <StackPanel MaxWidth="{StaticResource AppMeasureContent}" HorizontalAlignment="Center">

                        <!-- ······ Step 1: choose server type ······ -->
                        <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource LiveStepVisibility}, ConverterParameter=Intent}">
                            <TextBlock Style="{StaticResource AppTitleText}" Text="Server type" />
                            <TextBlock Style="{StaticResource AppSecondaryText}" TextWrapping="Wrap"
                                       Margin="{StaticResource AppStackGap}"
                                       Text="Choose Vanilla to continue in this development build." />

                            <ListBox x:Name="IntentList" ItemsSource="{Binding AvailableIntents}"
                                     SelectedItem="{Binding SelectedIntent}"
                                     AutomationProperties.Name="Server type"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     KeyboardNavigation.DirectionalNavigation="Cycle">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid>
                                            <UniformGrid.Style>
                                                <Style TargetType="UniformGrid">
                                                    <Setter Property="Columns" Value="2" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(ds:AppLayout.Mode), RelativeSource={RelativeSource Self}}" Value="Compact">
                                                            <Setter Property="Columns" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </UniformGrid.Style>
                                        </UniformGrid>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource AppListRow}">
                                        <Setter Property="Padding" Value="{StaticResource AppInsetNone}" />
                                        <Setter Property="Margin" Value="{StaticResource AppInset4}" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                        <Style.Triggers>
                                            <!-- A card that cannot start anything is not selectable, so it
                                                 never looks like a choice that simply failed to take. -->
                                            <DataTrigger Binding="{Binding IsLive}" Value="False">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="IntentCard" Style="{StaticResource AppCard}"
                                                Padding="{StaticResource AppInsetNone}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="IntentEdge" Grid.Column="0"
                                                        Width="0"
                                                        Background="{DynamicResource AppSurfaceTransparent}" />
                                                <Grid Grid.Column="1" Margin="{StaticResource AppCardPadding}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ds:AppIcon Grid.Column="0" Kind="{Binding Icon}" Scale="Hero"
                                                                VerticalAlignment="Top"
                                                                Margin="{StaticResource AppInlineGapLarge}"
                                                                Foreground="{DynamicResource AppTextSecondary}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Style="{StaticResource AppSubtitleText}"
                                                                   TextWrapping="Wrap" Text="{Binding Title}" />
                                                        <TextBlock Style="{StaticResource AppSecondaryText}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="{StaticResource AppStackGapTiny}"
                                                                   Text="{Binding Description}" />
                                                        <TextBlock Style="{StaticResource AppMutedText}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="{StaticResource AppStackGapTiny}"
                                                                   Text="{Binding Availability}" />
                                                    </StackPanel>
                                                    <ds:AppIcon x:Name="IntentChosen" Grid.Column="2" Kind="Checkmark"
                                                                Scale="Medium" VerticalAlignment="Center"
                                                                Visibility="Collapsed"
                                                                Margin="{StaticResource AppInlineGapLeading}"
                                                                Foreground="{DynamicResource AppTextAccent}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="IntentCard" Property="Background" Value="{DynamicResource AppSurfaceHover}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="IntentCard" Property="Background" Value="{DynamicResource AppSurfaceSelected}" />
                                                <Setter TargetName="IntentCard" Property="BorderBrush" Value="{DynamicResource AppAccentIndicator}" />
                                                <Setter TargetName="IntentChosen" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <components:AppAlert Tone="Info" Margin="{StaticResource AppStackGapTop}"
                                                 Title="More server types are planned"
                                                 Message="Plugins, mods, modpacks, crossplay, and advanced setup are not available in this development build." />

                        </StackPanel>

                        <!-- ······ Step 2: set up Vanilla ······ -->
                        <StackPanel MaxWidth="{StaticResource AppContentMaxWidth}" HorizontalAlignment="Stretch"
                                    Visibility="{Binding CurrentStep, Converter={StaticResource LiveStepVisibility}, ConverterParameter=Setup}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <!-- A StackPanel otherwise keeps only its children's natural
                                         width even when centred in a large ScrollViewer. -->
                                    <Setter Property="MinWidth" Value="{StaticResource AppMeasureForm}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=(ds:AppLayout.Mode), RelativeSource={RelativeSource Self}}" Value="Compact">
                                            <Setter Property="MinWidth" Value="0" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Path=(ds:AppLayout.Mode), RelativeSource={RelativeSource Self}}" Value="Wide">
                                            <Setter Property="MinWidth" Value="{StaticResource AppMeasureWizard}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource AppTitleText}" Text="Vanilla setup" />

                            <components:AppSectionCard Header="Name" Icon="Edit"
                                                       Margin="{StaticResource AppStackGapTop}"
                                                       Description="Also used for the folder name.">
                                <StackPanel>
                                    <!--
                                        No example name. A pre-filled suggestion reads as content the
                                        user has to clear, and the one that shipped here put the caret
                                        immediately in front of wording that could not be edited. This
                                        is a watermark: it names the field, and it goes the moment the
                                        field is focused.
                                    -->
                                    <TextBox x:Name="ServerNameBox"
                                             MaxWidth="{StaticResource AppMeasureForm}"
                                             HorizontalAlignment="Stretch"
                                             Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}"
                                             ds:AppInput.Placeholder="Server name"
                                             AutomationProperties.Name="Server name"
                                             AutomationProperties.HelpText="Validation problems are announced directly below this field.">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource AppTextBox}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasNameMessages}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AppDanger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <components:AppAlert Tone="Danger" Margin="{StaticResource AppStackGapTop}"
                                                         Title="Use a different name"
                                                         Visibility="{Binding HasNameMessages, Converter={StaticResource LiveBoolVisibility}}"
                                                         AutomationProperties.Name="Problems with this name"
                                                         AutomationProperties.LiveSetting="Assertive">
                                        <components:AppAlert.DetailContent>
                                            <ItemsControl ItemsSource="{Binding NameMessages}" Focusable="False"
                                                          ItemTemplate="{StaticResource LiveMessageTemplate}" />
                                        </components:AppAlert.DetailContent>
                                    </components:AppAlert>
                                </StackPanel>
                            </components:AppSectionCard>

                            <components:AppSectionCard Header="Memory allocation" Icon="Hardware"
                                                       Margin="{StaticResource AppStackGapTop}"
                                                       Description="Maximum memory available to this server. You can type an exact amount or choose a preset.">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding MaximumMemoryText, UpdateSourceTrigger=PropertyChanged}"
                                                 ds:AppInput.Placeholder="Example: 4.6"
                                                 AutomationProperties.Name="Maximum memory" />
                                        <TextBlock Grid.Column="1" Text="GB" Style="{StaticResource AppBodyStrongText}"
                                                   VerticalAlignment="Center" Margin="{StaticResource AppInlineGapLeadingLarge}" />
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding MemoryPresets}"
                                                  SelectedItem="{Binding SelectedMemoryPreset, Mode=TwoWay}"
                                                  Margin="{StaticResource AppInlineGapLeadingLarge}"
                                                  AutomationProperties.Name="Memory presets" />
                                    </Grid>
                                    <components:AppAlert Tone="Danger" Title="Choose a valid memory amount"
                                                         Message="{Binding MaximumMemoryInputError}"
                                                         Margin="{StaticResource AppStackGapTop}"
                                                         Visibility="{Binding HasMaximumMemoryInputError, Converter={StaticResource LiveBoolVisibility}}"
                                                         AutomationProperties.LiveSetting="Assertive" />
                                </StackPanel>
                            </components:AppSectionCard>

                            <components:AppSectionCard Header="Server port" Icon="Network"
                                                       Margin="{StaticResource AppStackGapTop}"
                                                       Description="The Java server listens on this TCP port. 25565 is the usual choice.">
                                <StackPanel>
                                    <TextBox Text="{Binding ServerPortText, UpdateSourceTrigger=PropertyChanged}"
                                             MaxWidth="{StaticResource AppSearchWidth}"
                                             HorizontalAlignment="Left"
                                             AutomationProperties.Name="Server port"
                                             AutomationProperties.HelpText="Enter a whole number from 1 to 65535." />
                                    <components:AppAlert Tone="Danger" Title="Choose a valid server port"
                                                         Message="{Binding ServerPortInputError}"
                                                         Margin="{StaticResource AppStackGapTop}"
                                                         Visibility="{Binding HasServerPortInputError, Converter={StaticResource LiveBoolVisibility}}"
                                                         AutomationProperties.LiveSetting="Assertive" />
                                </StackPanel>
                            </components:AppSectionCard>

                            <components:AppSectionCard Header="Who do you want to play with?" Icon="People"
                                                       Margin="{StaticResource AppStackGapTop}"
                                                       Description="This chooses the guidance shown after creation. It does not open a port or change Windows Firewall.">
                                <ComboBox ItemsSource="{Binding NetworkingOptions}"
                                          SelectedValuePath="Preference"
                                          SelectedValue="{Binding NetworkingPreference, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="Networking preference">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource AppBodyStrongText}" />
                                                    <components:AppStatusBadge Text="Recommended" Tone="Accent" IsSubtle="True"
                                                                                 Margin="{StaticResource AppInlineGapLeadingLarge}"
                                                                                 Visibility="{Binding IsRecommended, Converter={StaticResource LiveBoolVisibility}}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource AppMutedText}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </components:AppSectionCard>

                            <!-- Location: a default that is recommended, and a way to change it. The
                                 choice is the parent folder; the folder name stays derived from the
                                 server name, so renaming keeps the chosen location.

                                 One statement and one path, not two labelled rows. "Folder: …" beside
                                 "Location: Default" read as two unrelated facts about the same thing. -->
                            <components:AppSectionCard Icon="Folder" Header="Location"
                                                       Margin="{StaticResource AppStackGapTop}"
                                                       Description="{Binding LocationSummary}">
                                <StackPanel>
                                    <!-- Mono for a path, ordinary text for the sentence that stands in
                                         for one. A sentence set in a monospaced face reads as a value. -->
                                    <TextBlock Style="{StaticResource AppMonoText}"
                                               Text="{Binding DestinationSummary}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding DestinationSummary}"
                                               Visibility="{Binding HasResolvedDestination, Converter={StaticResource LiveBoolVisibility}}" />
                                    <TextBlock Style="{StaticResource AppMutedText}"
                                               Text="{Binding DestinationSummary}"
                                               Visibility="{Binding HasResolvedDestination, Converter={StaticResource LiveBoolVisibility}, ConverterParameter=invert}" />
                                    <components:AppAlert Tone="Danger" Margin="{StaticResource AppStackGapTop}"
                                                         Title="This location cannot be used"
                                                         Visibility="{Binding HasLocationMessages, Converter={StaticResource LiveBoolVisibility}}"
                                                         AutomationProperties.LiveSetting="Assertive">
                                        <components:AppAlert.DetailContent>
                                            <ItemsControl ItemsSource="{Binding LocationMessages}" Focusable="False"
                                                          ItemTemplate="{StaticResource LiveMessageTemplate}" />
                                        </components:AppAlert.DetailContent>
                                    </components:AppAlert>
                                    <WrapPanel Margin="{StaticResource AppStackGapTop}"
                                               Visibility="{Binding CanChooseLocation, Converter={StaticResource LiveBoolVisibility}}">
                                        <Button Content="Change…" Command="{Binding ChooseLocationCommand}"
                                                ds:AppButton.Icon="FolderOpen"
                                                Margin="{StaticResource AppInlineGap}"
                                                AutomationProperties.Name="Change where this server is created" />
                                        <Button Content="Use default" Command="{Binding UseDefaultLocationCommand}"
                                                ds:AppButton.Icon="Undo"
                                                Margin="{StaticResource AppInlineGap}"
                                                Visibility="{Binding IsCustomLocation, Converter={StaticResource LiveBoolVisibility}}"
                                                AutomationProperties.Name="Return to the default managed location" />
                                    </WrapPanel>
                                </StackPanel>
                            </components:AppSectionCard>

                            <components:AppSectionCard Icon="Options" Header="Minecraft version"
                                                       Margin="{StaticResource AppStackGapTop}"
                                                       Description="From Mojang's official version list.">
                                <StackPanel>
                                    <WrapPanel>
                                        <CheckBox x:Name="SnapshotToggle" IsChecked="{Binding IncludeSnapshots}"
                                                  Margin="{StaticResource AppInlineGap}"
                                                  Content="Include snapshots"
                                                  AutomationProperties.Name="Include in-development snapshots" />
                                        <Button Content="Refresh" Command="{Binding RefreshCatalogCommand}"
                                                ds:AppButton.Icon="Refresh"
                                                Margin="{StaticResource AppInlineGap}"
                                                AutomationProperties.Name="Refresh the version list from Mojang" />
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource AppMutedText}" TextWrapping="Wrap"
                                               Margin="{StaticResource AppStackGap}"
                                               Text="{Binding ChannelDescription}" />

                                    <components:AppLoadingState Title="Loading versions"
                                                                Message="Reading the official version list. Nothing is downloaded yet."
                                                                Visibility="{Binding IsCatalogLoading, Converter={StaticResource LiveBoolVisibility}}" />

                                    <components:AppStatusBadge HorizontalAlignment="Left"
                                                               Margin="{StaticResource AppStackGap}"
                                                               Tone="Info" Icon="History"
                                                               Text="{Binding CatalogStateHeadline}"
                                                               Visibility="{Binding ShowsCacheNotice, Converter={StaticResource LiveBoolVisibility}}" />

                                    <components:AppAlert Tone="Warning" Margin="{StaticResource AppStackGap}"
                                                         Title="{Binding CatalogStateHeadline}"
                                                         Message="{Binding CatalogDetail}"
                                                         Visibility="{Binding ShowsCatalogWarning, Converter={StaticResource LiveBoolVisibility}}" />

                                    <components:AppEmptyState Icon="Globe"
                                                              Title="{Binding CatalogStateHeadline}"
                                                              Message="{Binding CatalogDetail}"
                                                              Visibility="{Binding ShowsCatalogProblem, Converter={StaticResource LiveBoolVisibility}}">
                                        <Button Content="Try again" Command="{Binding RefreshCatalogCommand}"
                                                Style="{StaticResource AppPrimaryButton}"
                                                ds:AppButton.Icon="Refresh"
                                                AutomationProperties.Name="Try loading the version list again" />
                                    </components:AppEmptyState>

                                    <ListBox x:Name="VersionList" ItemsSource="{Binding Versions}"
                                             SelectedItem="{Binding SelectedVersion}"
                                             ItemContainerStyle="{StaticResource LiveVersionContainer}"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             Visibility="{Binding HasVersions, Converter={StaticResource LiveBoolVisibility}}"
                                             AutomationProperties.Name="Minecraft version">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <components:AppServerRow
                                                    ServerName="{Binding VersionId, StringFormat=Minecraft {0}}"
                                                    Subtitle="{Binding Converter={StaticResource VersionSubtitle}}"
                                                    Tone="{Binding Support, Converter={StaticResource SupportTone}}"
                                                    StateText="{Binding Support, Converter={StaticResource SupportBadge}}"
                                                    IsSelected="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}">
                                                </components:AppServerRow>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </components:AppSectionCard>

                            <components:AppSectionCard Icon="ShieldChecked" Header="Selection"
                                                       Margin="{StaticResource AppStackGapTop}"
                                                       Description="From this version's official metadata."
                                                       Visibility="{Binding HasSelectedVersion, Converter={StaticResource LiveBoolVisibility}}">
                                <StackPanel>
                                    <components:AppStatusBadge HorizontalAlignment="Left"
                                                               Text="{Binding VersionSupportText}"
                                                               Tone="{Binding SelectedVersion.Support, Converter={StaticResource SupportTone}}"
                                                               Icon="{Binding SelectedVersion.Support, Converter={StaticResource SupportIcon}}" />
                                    <components:AppInfoRow Label="Java requirement"
                                                           Margin="{StaticResource AppStackGapTop}"
                                                           Value="{Binding VersionJavaText}" />
                                    <components:AppInfoRow Label="Runtime plan" Value="{Binding ManagedJavaSummary}" />
                                    <components:AppInfoRow Label="Artifact source" Value="{Binding VersionArtifactText}" />
                                    <TextBlock Style="{StaticResource AppMutedText}" TextWrapping="Wrap"
                                               Margin="{StaticResource AppStackGapTop}"
                                               Text="Java stays private to ChunkPilot. PATH and JAVA_HOME are unchanged." />
                                </StackPanel>
                            </components:AppSectionCard>

                            <components:AppAlert Tone="Danger" Margin="{StaticResource AppStackGapTop}"
                                                 Title="This cannot continue yet"
                                                 Visibility="{Binding HasBlockingMessages, Converter={StaticResource LiveBoolVisibility}}"
                                                 AutomationProperties.LiveSetting="Assertive">
                                <components:AppAlert.DetailContent>
                                    <ItemsControl ItemsSource="{Binding BlockingMessages}" Focusable="False"
                                                  ItemTemplate="{StaticResource LiveMessageTemplate}" />
                                </components:AppAlert.DetailContent>
                            </components:AppAlert>

                            <components:AppAlert Tone="Warning" Margin="{StaticResource AppStackGapTop}"
                                                 Title="Worth knowing before you continue"
                                                 Visibility="{Binding HasWarningMessages, Converter={StaticResource LiveBoolVisibility}}">
                                <components:AppAlert.DetailContent>
                                    <ItemsControl ItemsSource="{Binding WarningMessages}" Focusable="False"
                                                  ItemTemplate="{StaticResource LiveMessageTemplate}" />
                                </components:AppAlert.DetailContent>
                            </components:AppAlert>
                        </StackPanel>

                        <!-- ······ Step 3: review and accept ······ -->
                        <StackPanel MaxWidth="{StaticResource AppMeasureForm}" HorizontalAlignment="Left"
                                    Visibility="{Binding CurrentStep, Converter={StaticResource LiveStepVisibility}, ConverterParameter=Review}">
                            <TextBlock x:Name="ReviewHeading" Style="{StaticResource AppTitleText}" Text="Review"
                                       Focusable="True" KeyboardNavigation.IsTabStop="False"
                                       AutomationProperties.Name="Review step" />
                            <TextBlock Style="{StaticResource AppSecondaryText}" TextWrapping="Wrap"
                                       Margin="{StaticResource AppStackGap}"
                                       Text="Nothing has been downloaded or written yet." />

                            <ItemsControl ItemsSource="{Binding Review.Sections}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <components:AppSectionCard Header="{Binding Title}">
                                            <StackPanel>
                                                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False"
                                                              ItemTemplate="{StaticResource LiveReviewRowTemplate}" />
                                                <ItemsControl ItemsSource="{Binding Notes}" Focusable="False"
                                                              Margin="{StaticResource AppStackGapTop}"
                                                              ItemTemplate="{StaticResource LiveReviewNoteTemplate}"
                                                              Visibility="{Binding Notes, Converter={StaticResource LiveAnyItems}}" />
                                            </StackPanel>
                                        </components:AppSectionCard>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!--
                                Compact, and still unmistakable. The requirement is stated once, in the
                                card's own description; the check box is the decision and starts clear.
                                Viewing the document changes nothing - the command only opens a browser -
                                so saying so in a sentence of its own was reassurance nobody asked for.
                            -->
                            <components:AppSectionCard Icon="Document" Header="Minecraft EULA"
                                                       Margin="{StaticResource AppStackGapTop}"
                                                       Description="Acceptance required.">
                                <StackPanel>
                                    <Button x:Name="OpenEulaButton" Content="View EULA"
                                            HorizontalAlignment="Left"
                                            Command="{Binding OpenEulaCommand}"
                                            ds:AppButton.Icon="Link"
                                            AutomationProperties.Name="View the Minecraft end user licence agreement in your browser" />
                                    <CheckBox x:Name="EulaBox" IsChecked="{Binding EulaAccepted}"
                                              Margin="{StaticResource AppStackGapTop}"
                                              Content="Accept the Minecraft EULA"
                                              AutomationProperties.Name="Accept the Minecraft end user licence agreement"
                                              AutomationProperties.HelpText="Required before this server can be created." />
                                    <TextBlock Style="{StaticResource AppMutedText}" TextWrapping="Wrap"
                                               Margin="{StaticResource AppStackGapTop}"
                                               AutomationProperties.LiveSetting="Polite"
                                               Text="{Binding EulaAcceptedDetail}" />
                                </StackPanel>
                            </components:AppSectionCard>

                            <components:AppAlert Tone="Danger" Margin="{StaticResource AppStackGapTop}"
                                                 Title="This cannot be created yet"
                                                 Visibility="{Binding Review.BlockingIssues, Converter={StaticResource LiveAnyItems}}">
                                <components:AppAlert.DetailContent>
                                    <ItemsControl ItemsSource="{Binding Review.BlockingIssues}" Focusable="False"
                                                  ItemTemplate="{StaticResource LiveMessageTemplate}" />
                                </components:AppAlert.DetailContent>
                            </components:AppAlert>

                            <components:AppAlert Tone="Warning" Margin="{StaticResource AppStackGapTop}"
                                                 Title="Worth knowing"
                                                 Message="None of these stop you, and all of them are true."
                                                 Visibility="{Binding Review.Warnings, Converter={StaticResource LiveAnyItems}}">
                                <components:AppAlert.DetailContent>
                                    <ItemsControl ItemsSource="{Binding Review.Warnings}" Focusable="False"
                                                  ItemTemplate="{StaticResource LiveMessageTemplate}" />
                                </components:AppAlert.DetailContent>
                            </components:AppAlert>

                            <components:AppSectionCard Icon="Diagnostics" Header="Download and verification details"
                                                       Margin="{StaticResource AppStackGapTop}"
                                                       IsCollapsible="True" IsExpanded="False"
                                                       Description="What ChunkPilot will download, where it comes from, and how it will be checked."
                                                       Visibility="{Binding Review.EvidenceRows, Converter={StaticResource LiveAnyItems}}">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding Review.EvidenceRows}" Focusable="False"
                                                  ItemTemplate="{StaticResource LiveReviewRowTemplate}" />
                                    <ItemsControl ItemsSource="{Binding Review.EvidenceNotes}" Focusable="False"
                                                  Margin="{StaticResource AppStackGapTop}"
                                                  ItemTemplate="{StaticResource LiveReviewNoteTemplate}" />
                                </StackPanel>
                            </components:AppSectionCard>
                        </StackPanel>

                        <!-- ······ Step 4: creating ······ -->
                        <StackPanel MaxWidth="{StaticResource AppMeasureForm}" HorizontalAlignment="Left"
                                    Visibility="{Binding CurrentStep, Converter={StaticResource LiveStepVisibility}, ConverterParameter=Creating}">
                            <TextBlock Style="{StaticResource AppTitleText}" Text="Creating" />
                            <TextBlock Style="{StaticResource AppSecondaryText}" TextWrapping="Wrap"
                                       Margin="{StaticResource AppStackGap}"
                                       Text="Runs in the background service. Closing this window does not stop it." />

                            <components:AppProgressPanel Title="{Binding OperationHeadline}"
                                                         StatusText="{Binding OperationDetail}"
                                                         Progress="{Binding ProgressPercent}"
                                                         IsIndeterminate="{Binding IsIndeterminate}"
                                                         Tone="{Binding EffectiveStage, Converter={StaticResource StageTone}}"
                                                         AutomationProperties.LiveSetting="Polite"
                                                         AutomationProperties.Name="Creation progress" />

                            <components:AppAlert Tone="Warning" Margin="{StaticResource AppStackGapTop}"
                                                 Title="{Binding OperationHeadline}"
                                                 Message="{Binding CancellationNotice}"
                                                 Visibility="{Binding ShowsCancellationNotice, Converter={StaticResource LiveBoolVisibility}}" />

                            <components:AppSectionCard Icon="Diagnostics" Header="Technical details"
                                                       Margin="{StaticResource AppStackGapTop}"
                                                       IsCollapsible="True" IsExpanded="False"
                                                       Description="Order of work and operation identity.">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AppSecondaryText}" TextWrapping="Wrap"
                                               Text="Java is prepared, the server is downloaded and checked against the published checksum, the files are assembled in a separate folder, and only then is the server put in place. Until that step the destination is unchanged." />
                                    <components:AppInfoRow Label="Operation" Margin="{StaticResource AppStackGapTop}"
                                                           Value="{Binding OperationIdText}" />
                                </StackPanel>
                            </components:AppSectionCard>
                        </StackPanel>

                        <!-- ······ Step 5: result ······ -->
                        <StackPanel MaxWidth="{StaticResource AppMeasureForm}" HorizontalAlignment="Left"
                                    Visibility="{Binding CurrentStep, Converter={StaticResource LiveStepVisibility}, ConverterParameter=Completion}">

                            <!-- Created -->
                            <StackPanel Visibility="{Binding IsSuccessful, Converter={StaticResource LiveBoolVisibility}}">
                                <components:AppEmptyState Icon="Success" Title="Server created"
                                                          Foreground="{DynamicResource AppSuccessText}"
                                                          Message="Your Vanilla server is ready to configure and start." />
                                <components:AppSectionCard Icon="Server" Header="Summary"
                                                           Margin="{StaticResource AppStackGapTop}">
                                    <StackPanel>
                                        <components:AppInfoRow Label="Name" Value="{Binding CreatedServerName}" />
                                        <components:AppInfoRow Label="Minecraft version" Value="{Binding CreatedServerVersion}" />
                                        <components:AppInfoRow Label="Runtime" Value="{Binding CreatedJavaSummary}" />
                                        <components:AppInfoRow Label="Initial state" Value="Stopped" />
                                        <components:AppInfoRow Label="Server port" Value="{Binding CreatedServerPort}" />
                                        <components:AppInfoRow Label="Next networking step" Value="{Binding NetworkingNextStep}" />
                                        <components:AppInfoRow Label="Public access" Value="Not configured" />
                                        <components:AppInfoRow Label="World" Value="Created on first start" />
                                        <components:AppInfoRow Label="Location" Value="{Binding CreatedServerPath}">
                                            <Button Content="Copy" ds:AppButton.Icon="Copy" Style="{StaticResource AppLinkButton}"
                                                    Command="{Binding CopyValueCommand}" CommandParameter="{Binding CreatedServerPath}"
                                                    AutomationProperties.Name="Copy the full server location" />
                                        </components:AppInfoRow>
                                    </StackPanel>
                                </components:AppSectionCard>
                                <components:AppSectionCard Icon="Diagnostics" Header="Runtime details"
                                                           IsCollapsible="True" IsExpanded="False"
                                                           Margin="{StaticResource AppStackGapTop}"
                                                           Description="Exact managed Java build assigned to this server.">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Java" Style="{StaticResource AppLabelText}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding CreatedJavaDetails}"
                                                   Style="{StaticResource AppBodyText}" TextWrapping="Wrap"
                                                   Margin="{StaticResource AppInlineGapLeadingLarge}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </components:AppSectionCard>
                            </StackPanel>

                            <!-- Needs attention -->
                            <StackPanel Visibility="{Binding NeedsAttention, Converter={StaticResource LiveBoolVisibility}}">
                                <components:AppEmptyState Icon="Warning" Title="Stopped to protect your files"
                                                          Message="Creation did not finish. Nothing further was changed and everything was left in place. This server is not ready and should not be used." />
                                <components:AppAlert Tone="Danger" Margin="{StaticResource AppStackGapTop}"
                                                     Title="What is known"
                                                     Message="{Binding OutcomeMessage}" />
                                <components:AppSectionCard Icon="Diagnostics" Header="Technical details"
                                                           Margin="{StaticResource AppStackGapTop}"
                                                           IsCollapsible="True" IsExpanded="False"
                                                           Description="Copy this if you need to look into it or report it.">
                                    <StackPanel>
                                        <components:AppInfoRow Label="Operation" Value="{Binding OperationIdText}" />
                                        <components:AppInfoRow Label="Folder" Value="{Binding DestinationSummary}" />
                                        <Button Content="Copy details" Command="{Binding CopyDiagnosticsCommand}"
                                                HorizontalAlignment="Left"
                                                Margin="{StaticResource AppStackGapTop}"
                                                ds:AppButton.Icon="Copy"
                                                AutomationProperties.Name="Copy the technical details to the clipboard" />
                                    </StackPanel>
                                </components:AppSectionCard>
                            </StackPanel>

                            <!-- Stopped or failed -->
                            <StackPanel Visibility="{Binding IsFailed, Converter={StaticResource LiveBoolVisibility}}">
                                <components:AppEmptyState Icon="Info" Title="{Binding OperationHeadline}"
                                                          Message="{Binding OutcomeMessage}" />
                                <components:AppSectionCard Icon="Diagnostics" Header="Technical details"
                                                           Margin="{StaticResource AppStackGapTop}"
                                                           IsCollapsible="True" IsExpanded="False"
                                                           Description="Copy this if you need to look into it.">
                                    <StackPanel>
                                        <components:AppInfoRow Label="Operation" Value="{Binding OperationIdText}" />
                                        <Button Content="Copy details" Command="{Binding CopyDiagnosticsCommand}"
                                                HorizontalAlignment="Left"
                                                Margin="{StaticResource AppStackGapTop}"
                                                ds:AppButton.Icon="Copy"
                                                AutomationProperties.Name="Copy the technical details to the clipboard" />
                                    </StackPanel>
                                </components:AppSectionCard>
                            </StackPanel>

                            <components:AppAlert Tone="Warning" Margin="{StaticResource AppStackGapTop}"
                                                 Title="Worth reading"
                                                 Visibility="{Binding OutcomeWarnings, Converter={StaticResource LiveAnyItems}}">
                                <components:AppAlert.DetailContent>
                                    <ItemsControl ItemsSource="{Binding OutcomeWarnings}" Focusable="False"
                                                  ItemTemplate="{StaticResource LiveMessageTemplate}" />
                                </components:AppAlert.DetailContent>
                            </components:AppAlert>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ═══ Action footer. Never scrolls, never moves. ═══ -->
            <StackPanel Grid.Row="3">
                <Border Style="{StaticResource AppDivider}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Position only. The development-build badge in the header already says what
                         this window is; repeating it in the footer of every step did not. -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                Margin="{StaticResource AppInlineGapLarge}">
                        <TextBlock Style="{StaticResource AppBodyStrongText}" Text="{Binding StepPosition}"
                                   AutomationProperties.Name="{Binding StepAutomationName}" />
                    </StackPanel>
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Back" Command="{Binding BackCommand}"
                                ds:AppButton.Icon="ChevronLeft"
                                Margin="{StaticResource AppInlineGap}"
                                AutomationProperties.Name="Back to the previous step"
                                Visibility="{Binding ShowsBack, Converter={StaticResource LiveBoolVisibility}}" />
                        <Button Content="Cancel" Command="{Binding CloseCommand}"
                                Margin="{StaticResource AppInlineGap}"
                                AutomationProperties.Name="Cancel and close without creating anything"
                                Visibility="{Binding ShowsCancelWizard, Converter={StaticResource LiveBoolVisibility}}" />
                        <Button x:Name="StopButton" Content="Cancel creation" Command="{Binding StopCommand}"
                                Margin="{StaticResource AppInlineGap}"
                                ds:AppButton.Icon="Stop"
                                AutomationProperties.Name="Stop creating this server"
                                Visibility="{Binding ShowsStop, Converter={StaticResource LiveBoolVisibility}}" />
                        <Button x:Name="NextButton" Content="Next" Command="{Binding NextCommand}"
                                Style="{StaticResource AppPrimaryButton}"
                                ds:AppButton.Icon="ChevronRight"
                                AutomationProperties.Name="Next step"
                                Visibility="{Binding ShowsNext, Converter={StaticResource LiveBoolVisibility}}" />
                        <Button x:Name="CreateButton" Content="Create server" Command="{Binding CreateCommand}"
                                Style="{StaticResource AppPrimaryButton}"
                                ds:AppButton.Icon="Add"
                                AutomationProperties.Name="Create this server now"
                                Visibility="{Binding ShowsCreate, Converter={StaticResource LiveBoolVisibility}}" />
                        <Button x:Name="OpenServerButton" Content="Open server" Command="{Binding OpenServerCommand}"
                                Style="{StaticResource AppPrimaryButton}"
                                Margin="{StaticResource AppInlineGap}"
                                ds:AppButton.Icon="Open"
                                AutomationProperties.Name="Open the server that was just created"
                                Visibility="{Binding ShowsOpenServer, Converter={StaticResource LiveBoolVisibility}}" />
                        <Button x:Name="CloseButton" Content="Close" Command="{Binding CloseCommand}"
                                ds:AppButton.Icon="Dismiss"
                                AutomationProperties.Name="Close this window"
                                Visibility="{Binding ShowsClose, Converter={StaticResource LiveBoolVisibility}}" />
                    </WrapPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
