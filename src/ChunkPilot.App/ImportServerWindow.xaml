<Window x:Class="ChunkPilot.App.ImportServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import existing Minecraft server" Width="820" Height="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource AppBackground}" Foreground="{StaticResource AppTextPrimary}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Confirm launch profile" Style="{StaticResource PageHeaderTitle}"/>
            <TextBlock Margin="0,6,0,16" Style="{StaticResource PageHeaderDescription}"
                       Text="The scan was read-only. ChunkPilot imports this folder by reference and will not move it."/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Server folder" Foreground="#B9ACC9"/>
                <TextBox Text="{Binding Detection.RootPath}" IsReadOnly="True"/>
                <TextBlock Text="Detected launch candidates" Foreground="#B9ACC9"/>
                <ListBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}" Height="150"
                         Background="#171221" BorderBrush="#44365E" Foreground="#F5F1FF" Margin="0,4,0,12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Reason}" Foreground="#B9ACC9" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Recommendation}"
                                           Foreground="#70CBEF" Margin="12,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="Name" Foreground="#B9ACC9"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Executable" Foreground="#B9ACC9"/>
                <TextBox Text="{Binding Executable, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Arguments" Foreground="#B9ACC9"/>
                <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="70"/>
                <TextBlock Text="Working directory" Foreground="#B9ACC9"/>
                <TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Readiness pattern" Foreground="#B9ACC9"/>
                <TextBox Text="{Binding ReadinessPattern, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Graceful shutdown timeout (seconds)" Foreground="#B9ACC9"/>
                <TextBox Text="{Binding ShutdownTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                <CheckBox Content="Run server in background (keeps integrated console capture enabled)"
                          IsChecked="{Binding RunInBackground}" Margin="0,4,0,12"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Background="#30283E" Click="Cancel_Click"/>
            <Button Content="Import server" Click="Import_Click"/>
        </StackPanel>
    </Grid>
</Window>
