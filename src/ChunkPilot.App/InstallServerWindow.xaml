<Window x:Class="ChunkPilot.App.InstallServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create a Server" Width="860" Height="800"
        MinWidth="720" MinHeight="620" WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackground}" Foreground="{StaticResource TextPrimary}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Create a Server" Style="{StaticResource PageHeaderTitle}"/>
            <TextBlock Text="Pick what you want to play. ChunkPilot handles Java, staging, validation, and a safe launch profile."
                       Style="{StaticResource PageHeaderDescription}" Margin="0,4,0,16"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Start with" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding QuickStarts}" SelectedItem="{Binding SelectedQuickStart}"
                                  DisplayMemberPath="Name" Margin="0,6,0,8"/>
                        <TextBlock Text="{Binding QuickStartDetail}" Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Server and modpack catalog" FontWeight="SemiBold"/>
                        <TextBlock Text="Uses official provider APIs. Client-only entries are hidden, and you choose an exact version."
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding CatalogProviders}" SelectedItem="{Binding CatalogProvider}"/>
                            <TextBox Grid.Column="1" Text="{Binding CatalogSearch}" Margin="8,0"
                                     ToolTip="Search Modrinth or a configured CurseForge account key"/>
                            <Button Grid.Column="2" Content="Browse" Command="{Binding BrowseCatalogCommand}"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding CatalogItems}" SelectedItem="{Binding SelectedCatalogItem}"
                                      DisplayMemberPath="Name" ToolTip="Server-capable projects only"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding CatalogVersions}"
                                      SelectedItem="{Binding SelectedCatalogVersion}" DisplayMemberPath="VersionName"
                                      Margin="8,0" ToolTip="Exact stable version; beta and alpha require an advanced query"/>
                            <Button Grid.Column="2" Content="Use exact version" Command="{Binding UseCatalogSelectionCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,12">
                        <TextBlock Text="Source type"/>
                        <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SourceType}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,12">
                        <TextBlock Text="Minecraft version"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Load versions" Command="{Binding LoadVersionsCommand}"
                                    Visibility="{Binding NeedsCatalogVersion, Converter={StaticResource BoolVisibility}}" Margin="8,0,0,0"/>
                            <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding MinecraftVersion}"
                                      IsEditable="True" Text="{Binding MinecraftVersion}"/>
                        </DockPanel>
                    </StackPanel>
                </Grid>
                <StackPanel Visibility="{Binding NeedsSourcePath, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12">
                    <TextBlock Text="Local package or direct URL"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseSourceCommand}" Margin="8,0,0,0"/>
                        <TextBox Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <CheckBox Content="Allow insecure HTTP after warning" IsChecked="{Binding AllowHttp}" Margin="0,6,0,0"/>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,12"><TextBlock Text="Server name"/><TextBox Text="{Binding ServerName}"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,12"><TextBlock Text="Build (optional; stable is selected by default)"/><TextBox Text="{Binding Build}"/></StackPanel>
                </Grid>
                <TextBlock Text="Managed instance root"/>
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseInstanceRootCommand}" Margin="8,0,0,0"/>
                    <TextBox Text="{Binding InstanceRoot}"/>
                </DockPanel>
                <TextBlock Text="Java executable"/>
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseJavaCommand}" Margin="8,0,0,0"/>
                    <TextBox Text="{Binding JavaPath}" ToolTip="The exact Java executable used for this server."/>
                </DockPanel>
                <CheckBox Content="Install or reuse private managed Java (recommended)"
                          IsChecked="{Binding UseManagedJava}" Margin="0,-6,0,12"
                          ToolTip="Stored per user. PATH, JAVA_HOME, Program Files, and system Java are never changed."/>
                <UniformGrid Columns="4" Margin="0,0,0,12">
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Xms (MB)"/><TextBox Text="{Binding MinimumRamMb}"/></StackPanel>
                    <StackPanel Margin="8,0"><TextBlock Text="Xmx (MB)"/><TextBox Text="{Binding MaximumRamMb}"/></StackPanel>
                    <StackPanel Margin="8,0"><TextBlock Text="Port"/><TextBox Text="{Binding Port}"/></StackPanel>
                    <StackPanel Margin="8,0,0,0"><TextBlock Text="Max players"/><TextBox Text="{Binding MaxPlayers}"/></StackPanel>
                </UniformGrid>
                <Border Style="{StaticResource Card}" Margin="0,4,0,12">
                    <StackPanel>
                        <CheckBox Content="I have read and agree to the Minecraft EULA."
                                  IsChecked="{Binding EulaAccepted}" FontWeight="SemiBold"/>
                        <Button Content="Open official EULA" Command="{Binding OpenEulaCommand}"
                                HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <ProgressBar Height="10" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"/>
                <TextBlock Text="{Binding CurrentStep}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                <TextBlock Text="{Binding ProgressDetail}" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                <TextBlock Text="{Binding StagingLogPath}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel installation" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
            <Button Content="Close" Click="Close_Click" Margin="0,0,8,0"/>
            <Button Content="Install server" Style="{StaticResource PrimaryActionButton}" Command="{Binding InstallCommand}"/>
        </StackPanel>
    </Grid>
</Window>
