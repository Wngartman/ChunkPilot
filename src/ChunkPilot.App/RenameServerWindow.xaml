<Window x:Class="ChunkPilot.App.RenameServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:ChunkPilot.App.DesignSystem.Components"
        Title="Rename server" Style="{StaticResource AppDialogWindow}"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="{StaticResource AppInset24}" MinWidth="{StaticResource AppMeasureForm}">
        <TextBlock Text="Display name" Style="{StaticResource AppTitleLargeText}"/>
        <TextBlock Text="Changes how this server appears in ChunkPilot. Its folder and files stay where they are."
                   Style="{StaticResource AppSecondaryText}" TextWrapping="Wrap"
                   Margin="{StaticResource AppStackGap}"/>
        <TextBox x:Name="NameBox" TextChanged="NameBox_TextChanged"
                 AutomationProperties.Name="Server display name"/>
        <components:AppAlert x:Name="ValidationAlert" Tone="Danger" Title="Use a different name"
                             Margin="{StaticResource AppStackGapTop}" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="{StaticResource AppStackGapTop}">
            <Button Content="Cancel" IsCancel="True" Margin="{StaticResource AppInlineGap}"/>
            <Button x:Name="SaveButton" Content="Save" Style="{StaticResource AppPrimaryButton}"
                    IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
