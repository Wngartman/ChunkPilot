<!--
    High-contrast overlay.

    Merged over the theme by AppTheme when Windows reports a high-contrast scheme. Because component
    styles reference brushes with DynamicResource, adding this dictionary re-styles live windows.

    Design decisions worth knowing:
      * Surfaces, text, strokes and accent come from Windows system colours. The user chose those
        colours; overriding them with a "nicer" palette is the whole failure mode high contrast
        exists to fix.
      * Strokes become fully visible. The default theme leans on subtle value differences for depth,
        which disappears entirely in high contrast, so borders are promoted rather than hidden.
      * Status FILLS keep their hue so a dot or bar stays distinguishable, but status surfaces and
        status text revert to system colours. Meaning is still carried by the mandatory text and
        glyph on every tone-bearing component, so nothing is lost when the hue is unavailable.

    Every key declared in Tokens/ColorTokens.xaml must appear here; a missing key would silently
    keep a hand-picked colour. DesignSystemContractTests enforces the coverage.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Self-contained: the palette is re-merged so this overlay resolves without depending on the
         order in which it happens to be added to a resource tree. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens/Palette.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ============ Surfaces ============ -->
    <SolidColorBrush x:Key="AppSurfaceWell" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="AppSurfaceCanvas" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="AppSurfaceSunken" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="AppSurface" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="AppSurfaceRaised" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="AppSurfaceOverlay" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="AppSurfaceHover" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AppSurfacePressed" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AppSurfaceSelected" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AppSurfaceDisabled" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="AppSurfaceTransparent" Color="Transparent" />
    <SolidColorBrush x:Key="AppSurfaceScrim" Color="{x:Static SystemColors.WindowColor}" Opacity="0.85" />

    <!-- ============ Strokes: promoted to fully visible ============ -->
    <SolidColorBrush x:Key="AppStrokeSubtle" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="AppStroke" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="AppStrokeStrong" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="AppStrokeDisabled" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="AppBorder" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="AppBorderStrong" Color="{x:Static SystemColors.WindowTextColor}" />

    <!-- ============ Text ============ -->
    <SolidColorBrush x:Key="AppTextPrimary" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="AppTextSecondary" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="AppTextTertiary" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="AppTextMuted" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="AppTextDisabled" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="AppTextOnAccent" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="AppTextAccent" Color="{x:Static SystemColors.HotTrackColor}" />

    <!-- ============ Accent and focus ============ -->
    <SolidColorBrush x:Key="AppAccent" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AppAccentHover" Color="{x:Static SystemColors.HotTrackColor}" />
    <SolidColorBrush x:Key="AppAccentPressed" Color="{x:Static SystemColors.HighlightColor}" />
    <!-- The indicator marks selection and active edges. It must stay distinguishable from the
         surface it sits on, which in high contrast is the system highlight. -->
    <SolidColorBrush x:Key="AppAccentIndicator" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AppAccentMuted" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AppAccentSubtle" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="AppAccentDisabled" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="AppFocusRing" Color="{x:Static SystemColors.HotTrackColor}" />

    <!-- ============ Status: hue kept for fills, system colours for surfaces and text ============ -->
    <SolidColorBrush x:Key="AppSuccess" Color="{StaticResource PaletteGreenBase}" />
    <SolidColorBrush x:Key="AppSuccessSubtle" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="AppSuccessText" Color="{x:Static SystemColors.WindowTextColor}" />

    <SolidColorBrush x:Key="AppWarning" Color="{StaticResource PaletteAmberBase}" />
    <SolidColorBrush x:Key="AppWarningSubtle" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="AppWarningText" Color="{x:Static SystemColors.WindowTextColor}" />

    <SolidColorBrush x:Key="AppDanger" Color="{StaticResource PaletteRedBase}" />
    <SolidColorBrush x:Key="AppDangerSubtle" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="AppDangerText" Color="{x:Static SystemColors.WindowTextColor}" />

    <SolidColorBrush x:Key="AppInfo" Color="{StaticResource PaletteBlueBase}" />
    <SolidColorBrush x:Key="AppInfoSubtle" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="AppInfoText" Color="{x:Static SystemColors.WindowTextColor}" />

    <SolidColorBrush x:Key="AppNeutral" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="AppNeutralSubtle" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="AppNeutralText" Color="{x:Static SystemColors.WindowTextColor}" />

    <!-- Shadows carry no information and are removed. -->
    <SolidColorBrush x:Key="AppShadowBrush" Color="Transparent" />
</ResourceDictionary>
