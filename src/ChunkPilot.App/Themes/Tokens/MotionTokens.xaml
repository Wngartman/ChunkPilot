<!--
    Motion tokens.

    Motion is brief, centralised and never required to understand a state change.
    Two mechanisms enforce Reduced Motion:
      1. Themes/Overlays/ReducedMotion.xaml replaces every duration below with zero.
      2. DesignSystem/AppMotion.IsEnabled is an inherited attached property that
         storyboard triggers test before running, so animations do not start at all.
    A component that cannot express its state without animation is not acceptable.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Duration x:Key="AppDurationInstant">0:0:0</Duration>
    <Duration x:Key="AppDurationPressIn">0:0:0.045</Duration>
    <Duration x:Key="AppDurationPressOut">0:0:0.07</Duration>
    <Duration x:Key="AppDurationFast">0:0:0.09</Duration>
    <Duration x:Key="AppDurationStandard">0:0:0.15</Duration>
    <Duration x:Key="AppDurationSlow">0:0:0.22</Duration>
    <Duration x:Key="AppDurationBusyCycle">0:0:1.1</Duration>

    <!-- Easing: decelerate on enter, no bounce, no overshoot anywhere. -->
    <CubicEase x:Key="AppEaseStandard" EasingMode="EaseOut" />
    <CubicEase x:Key="AppEaseExit" EasingMode="EaseIn" />

    <!-- Travel distances for enter transitions; zeroed under Reduced Motion. -->
    <sys:Double x:Key="AppMotionOffsetSmall">4</sys:Double>
    <sys:Double x:Key="AppMotionOffset">8</sys:Double>
</ResourceDictionary>
