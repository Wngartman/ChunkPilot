<!--
    Overlay layer: tooltips, context menus and dialog surfaces.

    Everything here floats above the page, so this is the only place shadows are used liberally.
    Windows' default light popups and menus are replaced outright - a light drop-down over a dark
    workspace was one of the most visible defects of the previous interface.

    Dialogs: AppDialogWindow keeps the native Windows frame (title bar, Alt+F4, snap, DPI handling)
    and restyles only the inside. Reinventing window chrome to look tidier costs real behaviour, and
    ChunkPilot is meant to feel native.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:ds="clr-namespace:ChunkPilot.App.DesignSystem">

    <!-- ============ Tooltip ============
         A tooltip adds detail. It never carries information required to act safely. -->
    <Style x:Key="AppToolTip" TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceOverlay}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppStrokeStrong}" />
        <Setter Property="BorderThickness" Value="{StaticResource AppStrokeThickness}" />
        <Setter Property="Padding" Value="{StaticResource AppTooltipPadding}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSizeSmall}" />
        <Setter Property="MaxWidth" Value="{StaticResource AppProseMaxWidth}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource AppCornerSmall}"
                            Padding="{TemplateBinding Padding}"
                            Effect="{StaticResource AppElevationOverlay}">
                        <!-- Typed template so plain-text tooltips wrap at MaxWidth instead of being
                             clipped, while richer tooltip content still presents normally. -->
                        <Border.Resources>
                            <DataTemplate DataType="{x:Type sys:String}">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource AppTextPrimary}" />
                            </DataTemplate>
                        </Border.Resources>
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ToolTip" BasedOn="{StaticResource AppToolTip}" />

    <!-- ============ Menus ============ -->
    <Style x:Key="AppContextMenu" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceOverlay}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppStrokeStrong}" />
        <Setter Property="BorderThickness" Value="{StaticResource AppStrokeThickness}" />
        <Setter Property="Padding" Value="{StaticResource AppMenuPadding}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource AppCornerCard}"
                            Padding="{TemplateBinding Padding}"
                            Effect="{StaticResource AppElevationOverlay}">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ContextMenu" BasedOn="{StaticResource AppContextMenu}" />

    <Style x:Key="AppMenuItem" TargetType="MenuItem">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceTransparent}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
        <Setter Property="Padding" Value="{StaticResource AppRowPadding}" />
        <Setter Property="MinHeight" Value="{StaticResource AppControlHeight}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource AppCornerSmall}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ds:AppIcon x:Name="Check" Kind="Checkmark" Scale="Small"
                                        Visibility="Collapsed"
                                        Margin="{StaticResource AppInlineGap}"
                                        Foreground="{DynamicResource AppTextAccent}" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header"
                                              VerticalAlignment="Center" RecognizesAccessKey="True" />
                            <TextBlock Grid.Column="2" Style="{StaticResource AppCaptionText}"
                                       VerticalAlignment="Center"
                                       Margin="{StaticResource AppInlineGapLarge}"
                                       Text="{TemplateBinding InputGestureText}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppSurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource AppTextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem" BasedOn="{StaticResource AppMenuItem}" />

    <Style x:Key="AppMenuSeparator" TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource AppStrokeSubtle}" />
        <Setter Property="Height" Value="{StaticResource AppHairlineHeight}" />
        <Setter Property="Margin" Value="{StaticResource AppInset4}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}" Height="{TemplateBinding Height}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Separator" BasedOn="{StaticResource AppMenuSeparator}" />

    <!-- ============ Dialogs ============ -->
    <!--
        WindowStartupLocation is deliberately absent: it is a plain CLR property on Window, not a
        dependency property, so a Setter for it throws when the style is realised. Each dialog window
        sets WindowStartupLocation="CenterOwner" on itself.
    -->
    <Style x:Key="AppDialogWindow" TargetType="Window" BasedOn="{StaticResource AppWindow}">
        <Setter Property="Background" Value="{DynamicResource AppSurface}" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="SizeToContent" Value="Height" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="Width" Value="{StaticResource AppDialogWidth}" />
    </Style>

    <!-- Header of a dialog: what will happen, stated plainly. -->
    <Style x:Key="AppDialogHeader" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppStrokeSubtle}" />
        <Setter Property="BorderThickness" Value="{StaticResource AppBottomStrokeThickness}" />
        <Setter Property="Padding" Value="{StaticResource AppSurfacePadding}" />
    </Style>

    <Style x:Key="AppDialogBody" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppSurface}" />
        <Setter Property="Padding" Value="{StaticResource AppSurfacePadding}" />
    </Style>

    <!-- Footer: cancel first in tab order, the committing action last and clearly labelled. -->
    <Style x:Key="AppDialogFooter" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceSunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppStrokeSubtle}" />
        <Setter Property="BorderThickness" Value="{StaticResource AppTopStrokeThickness}" />
        <Setter Property="Padding" Value="{StaticResource AppCardPadding}" />
    </Style>

    <!-- In-window modal surface, for confirmations that must show what will change. -->
    <Style x:Key="AppDialogSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceOverlay}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppStrokeStrong}" />
        <Setter Property="BorderThickness" Value="{StaticResource AppStrokeThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerSurface}" />
        <Setter Property="Padding" Value="{StaticResource AppSurfacePadding}" />
        <Setter Property="MaxWidth" Value="{StaticResource AppDialogWidth}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Effect" Value="{StaticResource AppElevationDialog}" />
    </Style>
</ResourceDictionary>
