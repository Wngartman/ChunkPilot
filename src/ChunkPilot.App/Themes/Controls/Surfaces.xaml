<!--
    Surfaces: the page container, cards, sections, dividers, page headers and the modal scrim.

    Depth is expressed by surface value and a hairline stroke, not by shadows or heavy borders.
    Exactly one level of grouping is allowed: a card may contain rows and controls, never another
    card. That single rule is what removes the "wall of boxes" look.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:ds="clr-namespace:ChunkPilot.App.DesignSystem"
                    xmlns:components="clr-namespace:ChunkPilot.App.DesignSystem.Components">

    <!-- ============ Containers ============ -->

    <!-- The outermost container of a destination. One per page. -->
    <Style x:Key="AppPageSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceCanvas}" />
        <Setter Property="Padding" Value="{StaticResource AppPagePadding}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(ds:AppLayout.Mode), RelativeSource={RelativeSource Self}}" Value="Compact">
                <Setter Property="Padding" Value="{StaticResource AppPagePaddingCompact}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Grouped content on the working surface. -->
    <Style x:Key="AppCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppStrokeSubtle}" />
        <Setter Property="BorderThickness" Value="{StaticResource AppStrokeThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerCard}" />
        <Setter Property="Padding" Value="{StaticResource AppCardPadding}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- One step brighter, for the single most important block on a surface. Use sparingly. -->
    <Style x:Key="AppRaisedCard" TargetType="Border" BasedOn="{StaticResource AppCard}">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppStroke}" />
    </Style>

    <!-- Recessed well for console output, logs and read-only payloads. -->
    <Style x:Key="AppSunkenSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceSunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppStrokeSubtle}" />
        <Setter Property="BorderThickness" Value="{StaticResource AppStrokeThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerCard}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Selected/accented context strip, for the current server or active operation. -->
    <Style x:Key="AppAccentSurface" TargetType="Border" BasedOn="{StaticResource AppCard}">
        <Setter Property="Background" Value="{DynamicResource AppAccentSubtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentMuted}" />
    </Style>

    <Style x:Key="AppDivider" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppStrokeSubtle}" />
        <Setter Property="Height" Value="{StaticResource AppHairlineHeight}" />
        <Setter Property="Margin" Value="{StaticResource AppStackGap}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Dims the page behind a modal surface. Must never be the only way to dismiss. -->
    <Style x:Key="AppScrim" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceScrim}" />
    </Style>

    <!--
        Icon toggle button. ToggleButton and Button cannot share a style, so the icon-button look is
        restated once here rather than in every disclosure header. Deliberately NOT an implicit
        ToggleButton style: the combo box template relies on an invisible full-bleed ToggleButton,
        and a global 32x32 icon style would silently shrink its hit area.
    -->
    <Style x:Key="AppIconToggleButton" TargetType="ToggleButton">
        <Setter Property="Width" Value="{StaticResource AppIconButtonSize}" />
        <Setter Property="Height" Value="{StaticResource AppIconButtonSize}" />
        <Setter Property="Background" Value="{DynamicResource AppSurfaceTransparent}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="FocusRing" Style="{StaticResource InternalFocusRing}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource AppCornerControl}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppSurfaceHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppSurfacePressed}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource AppFocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource AppTextDisabled}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="ds:AppMotion.IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                         To="0.96" Duration="{StaticResource AppDurationPressIn}" />
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                         To="0.96" Duration="{StaticResource AppDurationPressIn}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                         To="1" Duration="{StaticResource AppDurationPressOut}" />
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                         To="1" Duration="{StaticResource AppDurationPressOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Page header ============ -->
    <Style x:Key="AppPageHeader" TargetType="{x:Type components:AppPageHeader}">
        <Setter Property="Margin" Value="{StaticResource AppStackGapLarge}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type components:AppPageHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ds:AppIcon x:Name="HeaderIcon" Scale="Large"
                                        Margin="{StaticResource AppInlineGapLarge}"
                                        Foreground="{DynamicResource AppTextSecondary}"
                                        Kind="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue=Question}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppTitleLargeText}"
                                           Text="{TemplateBinding Title}" />
                                <TextBlock x:Name="Description" Style="{StaticResource AppSecondaryText}"
                                           Margin="{StaticResource AppStackGapTiny}"
                                           Text="{TemplateBinding Description}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="Actions" Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <ContentPresenter Content="{TemplateBinding StatusContent}"
                                              Margin="{StaticResource AppInlineGapLarge}"
                                              VerticalAlignment="Center" />
                            <ContentPresenter Content="{TemplateBinding SecondaryContent}"
                                              Margin="{StaticResource AppInlineGap}"
                                              VerticalAlignment="Center" />
                            <ContentPresenter Content="{TemplateBinding PrimaryContent}"
                                              VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="HeaderIcon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!-- Compact: actions move under the title instead of squeezing it. The
                             primary action is never dropped, only relocated. -->
                        <DataTrigger Binding="{Binding Path=(ds:AppLayout.Mode), RelativeSource={RelativeSource Self}}" Value="Compact">
                            <Setter TargetName="Actions" Property="Grid.Row" Value="1" />
                            <Setter TargetName="Actions" Property="Grid.Column" Value="0" />
                            <Setter TargetName="Actions" Property="Margin" Value="{StaticResource AppStackGapSmall}" />
                            <Setter TargetName="Actions" Property="HorizontalAlignment" Value="Left" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type components:AppPageHeader}" BasedOn="{StaticResource AppPageHeader}" />

    <!-- ============ Section card ============ -->
    <Style x:Key="AppSectionCard" TargetType="{x:Type components:AppSectionCard}">
        <Setter Property="Margin" Value="{StaticResource AppStackGap}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource AppSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppStrokeSubtle}" />
        <Setter Property="BorderThickness" Value="{StaticResource AppStrokeThickness}" />
        <Setter Property="Padding" Value="{StaticResource AppSurfacePadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type components:AppSectionCard}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource AppCornerCard}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <StackPanel>
                            <Grid x:Name="HeaderRow">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ds:AppIcon x:Name="SectionIcon" Scale="Medium" VerticalAlignment="Top"
                                            Margin="{StaticResource AppInlineGapLarge}"
                                            Foreground="{DynamicResource AppTextSecondary}"
                                            Kind="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue=Question}" />
                                <StackPanel Grid.Column="1">
                                    <!-- A plain string Header is auto-templated by WPF's built-in
                                         string DataTemplate, which defaults to NoWrap and clipped
                                         headers on any card narrower than its title. TextWrapping
                                         is not an attached property, so it cannot be set the way
                                         FontSize/FontWeight are above; overriding the string
                                         DataTemplate in this scope is the correct fix. -->
                                     <ContentPresenter ContentSource="Header"
                                                       TextBlock.FontSize="{StaticResource AppFontSizeSubtitle}"
                                                       TextBlock.FontWeight="{StaticResource AppFontWeightStrong}"
                                                       TextBlock.Foreground="{TemplateBinding Foreground}">
                                        <ContentPresenter.Resources>
                                            <DataTemplate DataType="{x:Type sys:String}">
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                    <TextBlock x:Name="Description" Style="{StaticResource AppMutedText}"
                                               Margin="{StaticResource AppStackGapTiny}"
                                               Text="{TemplateBinding Description}" />
                                </StackPanel>
                                <ContentPresenter Grid.Column="2" Content="{TemplateBinding HeaderContent}"
                                                  VerticalAlignment="Center"
                                                  Margin="{StaticResource AppInlineGap}" />
                                <ToggleButton x:Name="Disclosure" Grid.Column="3"
                                              Style="{StaticResource AppIconToggleButton}"
                                              Visibility="Collapsed"
                                              VerticalAlignment="Center"
                                              ToolTip="Show or hide these settings"
                                              AutomationProperties.Name="Show or hide these settings"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ds:AppIcon x:Name="DisclosureIcon" Kind="ChevronDown" Scale="Small"
                                                Foreground="{DynamicResource AppTextMuted}" />
                                </ToggleButton>
                                <!-- The visible chevron is a status affordance; this transparent
                                     control owns the complete header hit area so disclosure does not
                                     depend on finding a tiny target. -->
                                <ToggleButton x:Name="HeaderDisclosure" Grid.ColumnSpan="4"
                                              Visibility="Collapsed" Cursor="Hand"
                                              Background="{DynamicResource AppSurfaceTransparent}"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              AutomationProperties.Name="Show or hide this section">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                            <ContentPresenter x:Name="Body" Margin="{StaticResource AppStackGapSmall}"
                                              VerticalAlignment="Top" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="SectionIcon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="HeaderRow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Body" Property="Margin" Value="{StaticResource AppInsetNone}" />
                        </Trigger>
                        <Trigger Property="IsCollapsible" Value="True">
                            <Setter TargetName="Disclosure" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Disclosure" Property="IsHitTestVisible" Value="False" />
                            <Setter TargetName="HeaderDisclosure" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsCollapsible" Value="True" />
                                <Condition Property="IsExpanded" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="DisclosureIcon" Property="Kind" Value="ChevronRight" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type components:AppSectionCard}" BasedOn="{StaticResource AppSectionCard}" />

</ResourceDictionary>
