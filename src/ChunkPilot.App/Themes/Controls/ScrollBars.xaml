<!--
    Scrolling.

    Thin, quiet scrollbars with no arrow buttons. Arrow steppers are a 4px target that nobody uses
    and they make every list look busier than it is.

    AppPageScrollViewer is the ONE approved vertical scroller for a destination's primary content.
    A second scroll region inside it traps the wheel and hides content, so nesting is prohibited and
    is checked by DesignSystemContractTests.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The grab area is the whole thumb; the pill is only what is drawn.

        Previously the thumb's template was the pill itself, inset by 4 on every side, so the
        pointer target was the two visible pixels and dragging demanded pixel-perfect aim. The
        transparent host now fills the thumb's full width and takes the hit test, while the pill
        keeps its restrained appearance. A transparent brush still hit-tests in WPF; a null one
        does not, which is the whole reason the host names a brush at all.
    -->
    <Style x:Key="InternalScrollBarThumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Grab" Background="{DynamicResource AppSurfaceTransparent}">
                        <Border x:Name="Root" Background="{DynamicResource AppStrokeStrong}"
                                CornerRadius="{StaticResource AppCornerPill}"
                                Width="{StaticResource AppScrollBarThumbThickness}"
                                HorizontalAlignment="Right"
                                Margin="{StaticResource AppScrollBarThumbInset}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover and drag are read from the grab area, so the feedback appears as
                             soon as the pointer is anywhere the drag would actually work. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppTextMuted}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppTextSecondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The horizontal thumb is the same idea rotated: the pill hugs the bottom edge. -->
    <Style x:Key="InternalScrollBarThumbHorizontal" TargetType="Thumb" BasedOn="{StaticResource InternalScrollBarThumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Grab" Background="{DynamicResource AppSurfaceTransparent}">
                        <Border x:Name="Root" Background="{DynamicResource AppStrokeStrong}"
                                CornerRadius="{StaticResource AppCornerPill}"
                                Height="{StaticResource AppScrollBarThumbThickness}"
                                VerticalAlignment="Bottom"
                                Margin="{StaticResource AppScrollBarThumbInsetHorizontal}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppTextMuted}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppTextSecondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppScrollBar" TargetType="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceTransparent}" />
        <Setter Property="Width" Value="{StaticResource AppScrollBarThickness}" />
        <Setter Property="MinWidth" Value="{StaticResource AppScrollBarThickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"
                                              Background="{DynamicResource AppSurfaceTransparent}"
                                              BorderThickness="{StaticResource AppStrokeThicknessNone}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"
                                              Background="{DynamicResource AppSurfaceTransparent}"
                                              BorderThickness="{StaticResource AppStrokeThicknessNone}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource InternalScrollBarThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="{StaticResource AppScrollBarThickness}" />
                <Setter Property="MinHeight" Value="{StaticResource AppScrollBarThickness}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Focusable="False" Opacity="0"
                                                      Background="{DynamicResource AppSurfaceTransparent}"
                                                      BorderThickness="{StaticResource AppStrokeThicknessNone}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Focusable="False" Opacity="0"
                                                      Background="{DynamicResource AppSurfaceTransparent}"
                                                      BorderThickness="{StaticResource AppStrokeThicknessNone}" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource InternalScrollBarThumbHorizontal}" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource AppScrollBar}" />

    <!--
        The single approved page scroller. Horizontal scrolling of primary content is prohibited.

        The vertical bar is an OVERLAY: content fills the full width and the bar is drawn on top of its
        right edge, in the same grid cell. That is what lets the grab target be 24 dip wide - a target
        people can actually hit - while the pill stays 4 dip and the content never shifts, neither when
        the bar appears nor between a page that scrolls and one that does not.

        Wheel and touchpad scrolling are untouched: this is the standard ScrollViewer template with the
        bar moved, so routed input, virtualization and CanContentScroll all behave as WPF intends.
    -->
    <Style x:Key="AppPageScrollViewer" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Background" Value="{DynamicResource AppSurfaceTransparent}" />
        <Setter Property="Padding" Value="{StaticResource AppInsetNone}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                Margin="{TemplateBinding Padding}"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                CanHorizontallyScroll="False"
                                                CanVerticallyScroll="False" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Orientation="Vertical"
                                   HorizontalAlignment="Right"
                                   Width="{StaticResource AppScrollBarHitWidth}"
                                   MinWidth="{StaticResource AppScrollBarHitWidth}"
                                   Cursor="Arrow"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   AutomationProperties.Name="Scroll this page" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
