<!--
    Feedback: alerts, toasts, the toast host, empty states and loading states.

    Between them these four components remove every excuse for a default MessageBox on a product
    path. An alert stays on the surface it describes, a toast confirms a finished outcome, an empty
    state explains absence, and a loading state distinguishes "waiting" from "nothing here".

    Every one of them requires words. None of them expresses its meaning through colour alone.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ds="clr-namespace:ChunkPilot.App.DesignSystem"
                    xmlns:components="clr-namespace:ChunkPilot.App.DesignSystem.Components">

    <!-- ============ Inline alert ============ -->
    <Style x:Key="AppAlert" TargetType="{x:Type components:AppAlert}">
        <Setter Property="Margin" Value="{StaticResource AppStackGap}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type components:AppAlert}">
                    <Border x:Name="Root" Background="{DynamicResource AppInfoSubtle}"
                            BorderBrush="{DynamicResource AppStroke}"
                            BorderThickness="{StaticResource AppStrokeThickness}"
                            CornerRadius="{StaticResource AppCornerCard}"
                            Padding="{StaticResource AppCardPadding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ds:AppIcon x:Name="Mark" Kind="Info" Scale="Medium" VerticalAlignment="Top"
                                        Margin="{StaticResource AppInlineGapLarge}"
                                        Foreground="{DynamicResource AppInfoText}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="Title" Style="{StaticResource AppBodyStrongText}"
                                           Foreground="{DynamicResource AppInfoText}"
                                           Text="{TemplateBinding Title}" />
                                <TextBlock x:Name="Message" Style="{StaticResource AppSecondaryText}"
                                           Margin="{StaticResource AppStackGapTiny}"
                                           Text="{TemplateBinding Message}" />
                                <ContentPresenter x:Name="Detail" Content="{TemplateBinding DetailContent}"
                                                  Margin="{StaticResource AppStackGapTiny}" />
                                <ContentPresenter x:Name="Actions" Content="{TemplateBinding ActionContent}"
                                                  Margin="{StaticResource AppStackGapTop}"
                                                  HorizontalAlignment="Left" />
                            </StackPanel>
                            <Button x:Name="Dismiss" Grid.Column="2"
                                    Style="{StaticResource AppIconButton}"
                                    VerticalAlignment="Top"
                                    ToolTip="Dismiss this message"
                                    AutomationProperties.Name="Dismiss this message"
                                    Command="{Binding DismissCommand, RelativeSource={RelativeSource TemplatedParent}}">
                                <ds:AppIcon Kind="Dismiss" Scale="Small" Foreground="{DynamicResource AppTextMuted}" />
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tone" Value="Neutral">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppNeutralSubtle}" />
                            <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource AppNeutralText}" />
                            <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
                        </Trigger>
                        <Trigger Property="Tone" Value="Success">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppSuccessSubtle}" />
                            <Setter TargetName="Mark" Property="Kind" Value="Success" />
                            <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource AppSuccessText}" />
                            <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource AppSuccessText}" />
                        </Trigger>
                        <Trigger Property="Tone" Value="Warning">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppWarningSubtle}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AppWarning}" />
                            <Setter TargetName="Mark" Property="Kind" Value="Warning" />
                            <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource AppWarningText}" />
                            <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource AppWarningText}" />
                        </Trigger>
                        <Trigger Property="Tone" Value="Danger">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppDangerSubtle}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AppDanger}" />
                            <Setter TargetName="Mark" Property="Kind" Value="Error" />
                            <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource AppDangerText}" />
                            <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource AppDangerText}" />
                        </Trigger>
                        <Trigger Property="Tone" Value="Accent">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppAccentSubtle}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AppAccentMuted}" />
                            <Setter TargetName="Mark" Property="Kind" Value="Sparkle" />
                            <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource AppTextAccent}" />
                            <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource AppTextAccent}" />
                        </Trigger>
                        <Trigger Property="Message" Value="">
                            <Setter TargetName="Message" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="DetailContent" Value="{x:Null}">
                            <Setter TargetName="Detail" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ActionContent" Value="{x:Null}">
                            <Setter TargetName="Actions" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!-- No dismiss affordance unless dismissing is genuinely offered. -->
                        <Trigger Property="DismissCommand" Value="{x:Null}">
                            <Setter TargetName="Dismiss" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type components:AppAlert}" BasedOn="{StaticResource AppAlert}" />

    <!-- ============ Toast ============ -->
    <Style x:Key="AppToast" TargetType="{x:Type components:AppToast}">
        <Setter Property="Width" Value="{StaticResource AppToastWidth}" />
        <Setter Property="Margin" Value="{StaticResource AppStackGapSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type components:AppToast}">
                    <Border x:Name="Root" Background="{DynamicResource AppSurfaceOverlay}"
                            BorderBrush="{DynamicResource AppStrokeStrong}"
                            BorderThickness="{StaticResource AppStrokeThickness}"
                            CornerRadius="{StaticResource AppCornerCard}"
                            Padding="{StaticResource AppCardPadding}"
                            Effect="{StaticResource AppElevationOverlay}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ds:AppIcon x:Name="Mark" Kind="Info" Scale="Medium" VerticalAlignment="Top"
                                        Margin="{StaticResource AppInlineGapLarge}"
                                        Foreground="{DynamicResource AppInfoText}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource AppBodyStrongText}"
                                           Text="{TemplateBinding Title}" />
                                <TextBlock x:Name="Message" Style="{StaticResource AppMutedText}"
                                           Margin="{StaticResource AppStackGapTiny}"
                                           Text="{TemplateBinding Message}" />
                                <ContentPresenter x:Name="Actions" Content="{TemplateBinding ActionContent}"
                                                  Margin="{StaticResource AppStackGapTiny}"
                                                  HorizontalAlignment="Left" />
                            </StackPanel>
                            <!-- Always dismissible, and reachable by keyboard. -->
                            <Button Grid.Column="2" Style="{StaticResource AppIconButton}"
                                    VerticalAlignment="Top"
                                    ToolTip="Dismiss" AutomationProperties.Name="Dismiss notification"
                                    Command="{Binding DismissCommand, RelativeSource={RelativeSource TemplatedParent}}">
                                <ds:AppIcon Kind="Dismiss" Scale="Small" Foreground="{DynamicResource AppTextMuted}" />
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tone" Value="Success">
                            <Setter TargetName="Mark" Property="Kind" Value="Success" />
                            <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource AppSuccessText}" />
                        </Trigger>
                        <Trigger Property="Tone" Value="Warning">
                            <Setter TargetName="Mark" Property="Kind" Value="Warning" />
                            <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource AppWarningText}" />
                        </Trigger>
                        <Trigger Property="Tone" Value="Danger">
                            <Setter TargetName="Mark" Property="Kind" Value="Error" />
                            <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource AppDangerText}" />
                        </Trigger>
                        <Trigger Property="Tone" Value="Neutral">
                            <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource AppNeutralText}" />
                        </Trigger>
                        <Trigger Property="Tone" Value="Accent">
                            <Setter TargetName="Mark" Property="Kind" Value="Sparkle" />
                            <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource AppTextAccent}" />
                        </Trigger>
                        <Trigger Property="Message" Value="">
                            <Setter TargetName="Message" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ActionContent" Value="{x:Null}">
                            <Setter TargetName="Actions" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type components:AppToast}" BasedOn="{StaticResource AppToast}" />

    <!-- Owned by the shell. Pages raise toasts through the shell, they never host their own. -->
    <Style x:Key="AppToastHost" TargetType="ItemsControl">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="{StaticResource AppInset24}" />
        <Setter Property="Background" Value="{DynamicResource AppSurfaceTransparent}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Empty state ============ -->
    <Style x:Key="AppEmptyState" TargetType="{x:Type components:AppEmptyState}">
        <Setter Property="Padding" Value="{StaticResource AppInset24}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextMuted}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type components:AppEmptyState}">
                    <Border Background="{DynamicResource AppSurfaceTransparent}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ds:AppIcon Scale="Hero" HorizontalAlignment="Center"
                                        Foreground="{TemplateBinding Foreground}"
                                        Kind="{TemplateBinding Icon}" />
                            <TextBlock Style="{StaticResource AppSubtitleText}"
                                       HorizontalAlignment="Center"
                                       Margin="{StaticResource AppStackGapTop}"
                                       Text="{TemplateBinding Title}" />
                            <TextBlock x:Name="Message" Style="{StaticResource AppSecondaryText}"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       MaxWidth="{StaticResource AppProseMaxWidth}"
                                       Margin="{StaticResource AppStackGapTiny}"
                                       Text="{TemplateBinding Message}" />
                            <ContentPresenter x:Name="Actions" Content="{TemplateBinding ActionContent}"
                                              HorizontalAlignment="Center"
                                              Margin="{StaticResource AppStackGapTop}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Message" Value="">
                            <Setter TargetName="Message" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!-- An empty state with no real action shows no action, never a dead button. -->
                        <Trigger Property="ActionContent" Value="{x:Null}">
                            <Setter TargetName="Actions" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type components:AppEmptyState}" BasedOn="{StaticResource AppEmptyState}" />

    <!-- ============ Loading state ============ -->
    <Style x:Key="AppLoadingState" TargetType="{x:Type components:AppLoadingState}">
        <Setter Property="Padding" Value="{StaticResource AppInset24}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type components:AppLoadingState}">
                    <Border Background="{DynamicResource AppSurfaceTransparent}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <components:AppBusyIndicator HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource AppSecondaryText}"
                                       HorizontalAlignment="Center"
                                       Margin="{StaticResource AppStackGapTop}"
                                       Text="{TemplateBinding Title}" />
                            <TextBlock x:Name="Message" Style="{StaticResource AppMutedText}"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       MaxWidth="{StaticResource AppProseMaxWidth}"
                                       Margin="{StaticResource AppStackGapTiny}"
                                       Text="{TemplateBinding Message}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Message" Value="">
                            <Setter TargetName="Message" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type components:AppLoadingState}" BasedOn="{StaticResource AppLoadingState}" />
</ResourceDictionary>
