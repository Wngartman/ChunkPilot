<!--
    Text entry, numeric entry, search and range inputs.

    Inputs sit on a recessed surface so a form reads as a set of fields rather than a set of boxes.
    Focus is a ring plus an accent edge - never colour alone. Validation failure changes the edge
    and is expected to be accompanied by a message; a red outline on its own tells the user nothing.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ds="clr-namespace:ChunkPilot.App.DesignSystem"
                    xmlns:components="clr-namespace:ChunkPilot.App.DesignSystem.Components">

    <!-- Chromeless text editor used inside composite inputs (number box, search box). -->
    <Style x:Key="InternalBareTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceTransparent}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
        <Setter Property="BorderThickness" Value="{StaticResource AppStrokeThicknessNone}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AppTextPrimary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AppAccent}" />
        <Setter Property="Padding" Value="{StaticResource AppInsetNone}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Single-line and multi-line text ============ -->
    <Style x:Key="AppTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceSunken}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppStroke}" />
        <Setter Property="BorderThickness" Value="{StaticResource AppStrokeThickness}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AppTextPrimary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AppAccent}" />
        <Setter Property="Padding" Value="{StaticResource AppTextFieldPadding}" />
        <Setter Property="MinHeight" Value="{StaticResource AppControlHeight}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSizeBody}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="FocusRing" Style="{StaticResource InternalFocusRing}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource AppCornerControl}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <TextBlock x:Name="Placeholder"
                                           Style="{StaticResource AppMutedText}"
                                           FontSize="{StaticResource AppFontSizeBody}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           IsHitTestVisible="False"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                           Visibility="Collapsed"
                                           Text="{Binding Path=(ds:AppInput.Placeholder), RelativeSource={RelativeSource TemplatedParent}}" />
                                <!--
                                    The scroll-bar visibilities are template-bound rather than fixed.
                                    A hard-coded Auto made a single-line field reserve a vertical
                                    scroll bar whenever the text view measured a fraction taller than
                                    the content area, which shifted the text and left the caret
                                    sitting away from it. Binding them lets TextBox.*ScrollBarVisibility
                                    decide, which is Hidden for a single line and Auto for the
                                    multi-line style. The alignments are bound for the same reason:
                                    without them the text view stretches and ignores
                                    VerticalContentAlignment.
                                -->
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                              Padding="{StaticResource AppInsetNone}"
                                              HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                              VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--
                            Hint text only while the field is empty AND not focused.

                            Dropping it on focus is the fix for a defect that looked like a caret bug:
                            with the hint still drawn, the caret sat at position 0 - correctly - which
                            put it immediately before wording the user could not edit. The field read as
                            containing text with the caret in the wrong place inside it. An empty field
                            with a visible caret and nothing else cannot be misread, and the hint comes
                            straight back when focus leaves an empty field.
                        -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value="" />
                                <Condition Property="IsKeyboardFocusWithin" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AppStrokeStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource AppFocusRing}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AppAccent}" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppSurface}" />
                            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppSurfaceDisabled}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AppStrokeDisabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource AppTextDisabled}" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AppDanger}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource AppTextBox}" />

    <Style x:Key="AppMultilineTextBox" TargetType="TextBox" BasedOn="{StaticResource AppTextBox}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MinHeight" Value="{StaticResource AppRowHeightLarge}" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style x:Key="AppMonoTextBox" TargetType="TextBox" BasedOn="{StaticResource AppTextBox}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamilyMono}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSizeSmall}" />
    </Style>

    <Style x:Key="AppPasswordBox" TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceSunken}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppStroke}" />
        <Setter Property="BorderThickness" Value="{StaticResource AppStrokeThickness}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AppTextPrimary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AppAccent}" />
        <Setter Property="Padding" Value="{StaticResource AppTextFieldPadding}" />
        <Setter Property="MinHeight" Value="{StaticResource AppControlHeight}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="FocusRing" Style="{StaticResource InternalFocusRing}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource AppCornerControl}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource AppFocusRing}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AppAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppSurfaceDisabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource AppTextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource AppPasswordBox}" />

    <!-- ============ Search ============
         Leading glyph, hint text, and a clear control that appears only when there is text. -->
    <Style x:Key="AppSearchBox" TargetType="{x:Type components:AppSearchBox}">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceSunken}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppStroke}" />
        <Setter Property="BorderThickness" Value="{StaticResource AppStrokeThickness}" />
        <Setter Property="MinHeight" Value="{StaticResource AppControlHeight}" />
        <Setter Property="MinWidth" Value="{StaticResource AppSearchWidth}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type components:AppSearchBox}">
                    <Border x:Name="FocusRing" Style="{StaticResource InternalFocusRing}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource AppCornerControl}"
                                Padding="{StaticResource AppControlPadding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ds:AppIcon Kind="Search" Scale="Small"
                                            Margin="{StaticResource AppInlineGap}"
                                            Foreground="{DynamicResource AppTextMuted}" />
                                <Grid Grid.Column="1">
                                    <TextBlock x:Name="Placeholder"
                                               Style="{StaticResource AppMutedText}"
                                               FontSize="{StaticResource AppFontSizeBody}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               IsHitTestVisible="False" VerticalAlignment="Center"
                                               Visibility="Collapsed"
                                               Text="{TemplateBinding Placeholder}" />
                                    <TextBox x:Name="PART_Editor"
                                             Style="{StaticResource InternalBareTextBox}"
                                             Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Button x:Name="ClearButton" Grid.Column="2"
                                        Style="{StaticResource AppIconButton}"
                                        Width="{StaticResource AppIconSizeLarge}"
                                        Height="{StaticResource AppIconSizeLarge}"
                                        ToolTip="Clear search"
                                        AutomationProperties.Name="Clear search"
                                        Command="{Binding ClearCommand, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ds:AppIcon Kind="Dismiss" Scale="Small" Foreground="{DynamicResource AppTextMuted}" />
                                </Button>
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Empty: hide a clear control that has nothing to clear. -->
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ClearButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!-- The hint follows the same rule as the plain text box: empty and unfocused. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value="" />
                                <Condition Property="IsKeyboardFocusWithin" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource AppFocusRing}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AppAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppSurfaceDisabled}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AppStrokeDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type components:AppSearchBox}" BasedOn="{StaticResource AppSearchBox}" />

    <!-- ============ Bounded numeric entry ============ -->
    <Style x:Key="AppNumberBox" TargetType="{x:Type components:AppNumberBox}">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceSunken}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppStroke}" />
        <Setter Property="BorderThickness" Value="{StaticResource AppStrokeThickness}" />
        <Setter Property="MinHeight" Value="{StaticResource AppControlHeight}" />
        <Setter Property="MinWidth" Value="{StaticResource AppSpace40}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type components:AppNumberBox}">
                    <Border x:Name="FocusRing" Style="{StaticResource InternalFocusRing}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource AppCornerControl}"
                                Padding="{StaticResource AppControlPaddingCompact}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource InternalBareTextBox}"
                                         Margin="{StaticResource AppInlineGap}"
                                         Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource AppIconButton}"
                                            Width="{StaticResource AppIconSizeLarge}"
                                            Height="{StaticResource AppIconSizeLarge}"
                                            ToolTip="Decrease" AutomationProperties.Name="Decrease value"
                                            Command="{Binding DecreaseCommand, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ds:AppIcon Kind="ChevronDown" Scale="Small" Foreground="{DynamicResource AppTextMuted}" />
                                    </Button>
                                    <Button Style="{StaticResource AppIconButton}"
                                            Width="{StaticResource AppIconSizeLarge}"
                                            Height="{StaticResource AppIconSizeLarge}"
                                            ToolTip="Increase" AutomationProperties.Name="Increase value"
                                            Command="{Binding IncreaseCommand, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ds:AppIcon Kind="ChevronUp" Scale="Small" Foreground="{DynamicResource AppTextMuted}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource AppFocusRing}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AppAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppSurfaceDisabled}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AppStrokeDisabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource AppTextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type components:AppNumberBox}" BasedOn="{StaticResource AppNumberBox}" />

    <!-- ============ Range ============ -->
    <Style x:Key="AppSlider" TargetType="Slider">
        <Setter Property="Foreground" Value="{DynamicResource AppAccent}" />
        <Setter Property="Background" Value="{DynamicResource AppSurfaceSunken}" />
        <Setter Property="MinHeight" Value="{StaticResource AppControlHeightCompact}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Border x:Name="FocusRing" Style="{StaticResource InternalFocusRing}"
                            CornerRadius="{StaticResource AppCornerPill}">
                        <Grid VerticalAlignment="Center">
                            <Border Height="{StaticResource AppProgressHeight}"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource AppCornerPill}" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False"
                                                  Opacity="0" Background="{DynamicResource AppSurfaceTransparent}"
                                                  BorderThickness="{StaticResource AppStrokeThicknessNone}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False"
                                                  Opacity="0" Background="{DynamicResource AppSurfaceTransparent}"
                                                  BorderThickness="{StaticResource AppStrokeThicknessNone}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="{StaticResource AppSelectionBoxSize}"
                                           Height="{StaticResource AppSelectionBoxSize}"
                                           Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource AppAccent}"
                                                         Stroke="{DynamicResource AppSurfaceCanvas}"
                                                         StrokeThickness="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource AppFocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider" BasedOn="{StaticResource AppSlider}" />
</ResourceDictionary>
