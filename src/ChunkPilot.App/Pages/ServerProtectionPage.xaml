<UserControl x:Class="ChunkPilot.App.ServerProtectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ds="clr-namespace:ChunkPilot.App.DesignSystem"
             xmlns:components="clr-namespace:ChunkPilot.App.DesignSystem.Components">
    <!--
        Protection destination sub-sections:
        - Backups
        - Automation (scheduled tasks)
        - Crash recovery (diagnostics)
        - Restore points (version snapshots)
    -->
    <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">

        <!-- ═══ Backups ═══ -->
        <TextBlock Text="BACKUPS" Style="{StaticResource AppEyebrowText}" Margin="{StaticResource AppNavSectionLabelInset}"/>
        <Border Style="{StaticResource AppCard}">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="Verified server snapshots" FontSize="{StaticResource AppFontSizeSubtitle}" FontWeight="SemiBold"/>
                    <Button DockPanel.Dock="Right" Content="Backup now" Style="{StaticResource AppPrimaryButton}" Command="{Binding CreateBackupCommand}"/>
                </DockPanel>
                <DataGrid ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" Height="200" Margin="0,8,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat=g}" Width="150"/>
                        <DataGridTextColumn Header="Archive" Binding="{Binding ArchivePath}" Width="*"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeBytes, Converter={StaticResource Bytes}}" Width="90"/>
                        <DataGridCheckBoxColumn Header="Verified" Binding="{Binding Verified}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Verify" Command="{Binding VerifyBackupCommand}" Margin="3"/>
                    <Button Content="Restore" Command="{Binding RestoreBackupCommand}" Margin="3"/>
                    <Button Content="Delete" Style="{StaticResource AppDangerButton}" Command="{Binding DeleteBackupCommand}" Margin="3"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══ Automation ═══ -->
        <TextBlock Text="AUTOMATION" Style="{StaticResource AppEyebrowText}" Margin="18,20,18,6"/>
        <Border Style="{StaticResource AppCard}">
            <StackPanel>
                <TextBlock Text="Scheduled protection tasks" FontSize="{StaticResource AppFontSizeSubtitle}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <DataGrid ItemsSource="{Binding Schedules}" Height="140">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="100"/>
                        <DataGridTextColumn Header="Next" Binding="{Binding NextRunAt, StringFormat=g}" Width="150"/>
                        <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="50"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- ═══ Crash recovery ═══ -->
        <TextBlock Text="CRASH RECOVERY" Style="{StaticResource AppEyebrowText}" Margin="18,20,18,6"/>
        <Border Style="{StaticResource AppCard}">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="Diagnostics" FontSize="{StaticResource AppFontSizeSubtitle}" FontWeight="SemiBold"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Run" Command="{Binding RunDiagnosticsCommand}" Margin="3"/>
                        <Button Content="Bundle" Command="{Binding CreateDiagnosticBundleCommand}" Margin="3"/>
                    </StackPanel>
                </DockPanel>
                <DataGrid ItemsSource="{Binding Diagnostics}" Height="180" Margin="0,8,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80"/>
                        <DataGridTextColumn Header="Finding" Binding="{Binding Title}" Width="200"/>
                        <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- ═══ Restore points ═══ -->
        <TextBlock Text="RESTORE POINTS" Style="{StaticResource AppEyebrowText}" Margin="18,20,18,6"
                   Visibility="{Binding ShowsVersionManager, Converter={StaticResource BoolVisibility}}"/>
        <Border Style="{StaticResource AppCard}" Visibility="{Binding ShowsVersionManager, Converter={StaticResource BoolVisibility}}">
            <StackPanel>
                <TextBlock Text="Version rollback snapshots" FontSize="{StaticResource AppFontSizeSubtitle}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <DataGrid ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" Height="160" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Version" Binding="{Binding VersionName}" Width="130"/>
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60"/>
                        <DataGridTextColumn Header="Health" Binding="{Binding Health}" Width="100"/>
                        <DataGridTextColumn Header="Snapshot" Binding="{Binding SnapshotSize, Converter={StaticResource Bytes}}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Roll back" Command="{Binding RollbackVersionCommand}" Margin="3"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
