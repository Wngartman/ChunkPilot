<!--
    Server console.

    Output owns the page; the filters sit above it and the command box is anchored below, so
    resizing grows the log rather than the chrome. The ListBox is the only scroll region: its
    ScrollChanged is what tells the view model whether the viewport is at the bottom, which is what
    makes live-follow pause when the user scrolls up to read something.
-->
<UserControl x:Class="ChunkPilot.App.ServerConsolePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ds="clr-namespace:ChunkPilot.App.DesignSystem"
             xmlns:components="clr-namespace:ChunkPilot.App.DesignSystem.Components">
    <Grid DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Filters ═══ -->
        <DockPanel Margin="{StaticResource AppStackGap}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource AppMutedText}" VerticalAlignment="Center"
                           Margin="{StaticResource AppInlineGap}"
                           Text="{Binding ConsoleFollowStateText}"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="Console follow state"/>
                <CheckBox Content="Follow" IsChecked="{Binding IsConsoleFollowing}" VerticalAlignment="Center"
                          AutomationProperties.Name="Follow new console output"/>
            </StackPanel>
            <WrapPanel>
                <TextBlock Text="Severity" Style="{StaticResource AppLabelText}" VerticalAlignment="Center"
                           Margin="{StaticResource AppInlineGap}"/>
                <ComboBox ItemsSource="{Binding ConsoleSeverities}" SelectedItem="{Binding ConsoleSeverity}"
                          Width="{StaticResource AppSearchWidth}" Margin="{StaticResource AppInlineGap}"
                          AutomationProperties.Name="Minimum severity"/>
                <components:AppSearchBox Text="{Binding ConsoleSearchText, Mode=TwoWay}"
                                         Placeholder="Filter visible lines"
                                         Margin="{StaticResource AppInlineGap}"
                                         AutomationProperties.Name="Filter visible console lines"/>
                <Button Content="Clear" Command="{Binding ClearConsoleViewCommand}"
                        ds:AppButton.Icon="Delete" Margin="{StaticResource AppInlineGap}"
                        AutomationProperties.Name="Clear the visible console output"/>
            </WrapPanel>
        </DockPanel>

        <!-- ═══ Output ═══ -->
        <ListBox x:Name="ConsoleList" Grid.Row="1" Style="{StaticResource AppConsoleSurface}"
                 ItemsSource="{Binding FilteredConsoleLines}"
                 AutomationProperties.Name="Server console output"
                 FontFamily="{StaticResource AppFontFamilyMono}" FontSize="{StaticResource AppFontSizeSmall}"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="True" SelectionMode="Extended">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock TextWrapping="Wrap"><Run Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Text, Mode=OneWay}"/></TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Offered only while follow is paused and output has arrived behind the viewport. -->
        <Button Grid.Row="1" Content="{Binding UnseenConsoleLines, StringFormat=Jump to latest · {0} new}"
                Command="{Binding JumpToLatestCommand}" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                Margin="{StaticResource AppInset16}" Style="{StaticResource AppPrimaryButton}"
                ds:AppButton.Icon="ChevronDown"
                AutomationProperties.Name="Jump to the latest console output and resume following"
                Visibility="{Binding UnseenConsoleLines, Converter={StaticResource PositiveIntVisibility}}"/>

        <!-- ═══ Command ═══ -->
        <DockPanel Grid.Row="2" Margin="{StaticResource AppStackGapTop}">
            <Button DockPanel.Dock="Right" Content="Send" Style="{StaticResource AppPrimaryButton}"
                    Command="{Binding SendConsoleCommandCommand}"
                    ds:AppButton.Icon="Send" Margin="{StaticResource AppInlineGapLeading}"
                    AutomationProperties.Name="Send this command to the server"/>
            <!-- A hint, not a label. "Command sent to the server" described what the field does and read
                 as content already in it, with the caret sitting inside wording that could not be
                 edited. The hint now reads as an instruction and disappears on focus. -->
            <TextBox x:Name="CommandBox"
                     Text="{Binding ConsoleCommand, UpdateSourceTrigger=PropertyChanged}"
                     ds:AppInput.Placeholder="Type a command"
                     AutomationProperties.Name="Console command">
                <!-- Enter routes through the same command as the button, so a disabled state cannot
                     be bypassed and an empty line cannot be sent. -->
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SendConsoleCommandCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>
    </Grid>
</UserControl>
